# ============================================================================
#  Gran UI — исключения для Git
#  Gran UI — Git exclusions
# ============================================================================

# ---- Любые каталоги, имя которых начинается с точки (на любом уровне) -------
# .vscode/, .idea/, .vs/, .cache/ и т.п. вместе со всем содержимым.
# ---- Any directories whose name starts with a dot (at any level) ------------
# .vscode/, .idea/, .vs/, .cache/ and so on with all their content.
.*/

# Исключение: workflow GitHub Actions / Exception: the GitHub Actions workflows
!/.github/

# ---- Результаты сборки Makefile / Makefile build results --------------------
/obj/
/dep/
/bin/

# ---- Встроенные схема и тема: генерируются при сборке (gran_embed) ----------
# ---- The embedded schema and theme: generated by the build (gran_embed) -----
/gen/

# ---- Черновики вне сборки / Drafts outside the build ------------------------
/staging/
/scratchpad/
*.dxbc

# ---- Результаты сборки CMake / CMake build results --------------------------
/build/
/build-*/
/cmake-build-*/
/out/
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
cmake_install.cmake
CTestTestfile.cmake
Testing/
install_manifest.txt
compile_commands.json

# ---- Объектные файлы, зависимости и бинарники (на случай сборки вне bin/) ---
# ---- Object files, dependencies and binaries (in case of a build outside bin/)
*.o
*.obj
*.d
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.out
*.pdb
*.ilk
*.exp
*.gch
*.pch
*.dxil
*.spv

# ---- Файлы IDE и редакторов / IDE and editor files --------------------------
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.suo
*.user
*.swp
*~

# ---- Системный мусор ОС / OS system clutter ---------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ---- Локальные заметки и рабочие документы (не публикуются) -----------------
# ---- Local notes and working documents (not published) ----------------------
/project_context.md
/ui_framework_concept*.md
/beresta_bug_*.md

# ---- Настройки ИИ-помощников и расширений редактора (у каждого разработчика свои) ----
# ---- AI assistant and editor extension settings (each developer has their own) -------
.aider*
.clinerules
.continueignore
.codex/
.continue/

# Захваты кадра RenderDoc из ручных проверок — большие, в git не добавляются (путь пишется в задаче)
# RenderDoc frame captures from manual checks are large and are not added to git (the task records the path)
tests/manual/results/**/*.rdc
