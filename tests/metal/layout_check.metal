/*
** Проверка раскладки структур GPU в MSL (make metal-check, только macOS). MSL генерирует spirv-cross,
** и выравнивание у Metal своё (float4 — 16 байт, float2 — 8), поэтому размеры и смещения GpuInstance,
** GpuClip и FrameConstants сверяются с теми же числами, что static_assert в include/gran/render/gpu_types.hpp.
** Расхождение — ошибка компиляции, а не испорченный кадр в бэкенде Metal (M5).
** Файл пишется руками; ui_ps.metal — сгенерированный (make shaders-metal), он не правится.
**
** The GPU struct layout check in MSL (make metal-check, macOS only). The MSL is generated by spirv-cross,
** and Metal has its own alignment (float4 is 16 bytes, float2 is 8), so the sizes and offsets of GpuInstance,
** GpuClip and FrameConstants are checked against the same numbers as the static_assert in
** include/gran/render/gpu_types.hpp. A mismatch is a compile error, not a corrupted frame in the Metal backend (M5).
** This file is hand-written; ui_ps.metal is generated (make shaders-metal) and is not edited.
*/
#include "ui_ps.metal"

// Экземпляр сцены: 128 байт, смещения полей — как в C++ и HLSL
// A scene instance: 128 bytes, the field offsets are as in C++ and HLSL
static_assert(sizeof(GpuInstance) == 128, "GpuInstance size");
static_assert(__builtin_offsetof(GpuInstance, radii) == 16, "GpuInstance.radii offset");
static_assert(__builtin_offsetof(GpuInstance, border) == 32, "GpuInstance.border offset");
static_assert(__builtin_offsetof(GpuInstance, transform) == 48, "GpuInstance.transform offset");
static_assert(__builtin_offsetof(GpuInstance, translate) == 64, "GpuInstance.translate offset");
static_assert(__builtin_offsetof(GpuInstance, opacity) == 72, "GpuInstance.opacity offset");
static_assert(__builtin_offsetof(GpuInstance, kind) == 80, "GpuInstance.kind offset");
static_assert(__builtin_offsetof(GpuInstance, extra) == 96, "GpuInstance.extra offset");
static_assert(__builtin_offsetof(GpuInstance, paint) == 112, "GpuInstance.paint offset");

// Отсечение: 64 байта; поле inverse spirv-cross называет _inverse (inverse — встроенная функция MSL)
// A clip: 64 bytes; spirv-cross names the inverse field _inverse (inverse is an MSL built-in function)
static_assert(sizeof(GpuClip) == 64, "GpuClip size");
static_assert(__builtin_offsetof(GpuClip, _inverse) == 32, "GpuClip.inverse offset");

// Константы кадра: 48 байт (12 значений по 4 байта)
// The frame constants: 48 bytes (12 values of 4 bytes)
static_assert(sizeof(type_ConstantBuffer_FrameConstants) == 48, "FrameConstants size");
static_assert(__builtin_offsetof(type_ConstantBuffer_FrameConstants, atlasSlot) == 32, "FrameConstants.atlasSlot offset");
