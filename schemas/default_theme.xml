<?xml version="1.0" encoding="UTF-8"?>
<!--
  Тема по умолчанию: стили видов элементов (как стили браузера по умолчанию для <button>, <input>).
  Имя стиля = имя элемента. Встраивается в библиотеку (gen/markup/default_theme.cpp) и проверяется
  той же схемой, что и разметка приложения. Атрибуты <Window> — умолчания окна.

  The default theme: the element kind styles (like the browser default styles for <button>, <input>).
  The style name = the element name. It is embedded into the library (gen/markup/default_theme.cpp) and checked
  by the same schema as the application markup. The <Window> attributes are the window defaults.
-->
<Window background="#ffffff" color="#101828" fontFamily="system-ui" fontSize="14" accentColor="#2563eb">
  <Resources>
    <Style name="Button" orientation="horizontal" justify="center" align="center" spacing="8" padding="8 16"
           borderRadius="8" background="#2563eb" color="#ffffff" fontWeight="600" textAlign="center" cursor="pointer"
           transition="background 0.15s ease, boxShadow 0.15s ease, transform 0.1s ease">
      <Hover background="#1d4ed8"/>
      <Pressed background="#1e40af" transform="scale(0.98)"/>
      <Focused boxShadow="0 0 0 3 rgba(37, 99, 235, 0.35)"/>
      <Disabled opacity="0.5"/>
    </Style>
    <Style name="Input" overflow="hidden" padding="8 12" borderWidth="1" borderColor="#d0d5dd" borderRadius="8" background="#ffffff"
           color="#101828" cursor="text" transition="borderColor 0.15s ease, boxShadow 0.15s ease">
      <Hover borderColor="#98a2b3"/>
      <Focused borderColor="#2563eb" boxShadow="0 0 0 3 rgba(37, 99, 235, 0.2)"/>
      <Disabled opacity="0.5"/>
    </Style>
    <Style name="TextArea" basedOn="Input" lineHeight="1.4"/>
    <Style name="CheckBox" cursor="pointer">
      <Disabled opacity="0.5"/>
    </Style>
    <Style name="Slider" cursor="pointer" minWidth="80">
      <Disabled opacity="0.5"/>
    </Style>
    <Style name="RadioButton" cursor="pointer">
      <Disabled opacity="0.5"/>
    </Style>
    <Style name="Switch" cursor="pointer">
      <Disabled opacity="0.5"/>
    </Style>
    <!-- Дорожка полосы прогресса — фон стиля, заполнение — accentColor / The progress bar track is the style background, the fill is accentColor -->
    <Style name="ProgressBar" minWidth="40" borderRadius="4" background="#e4e7ec"/>
    <!-- Вкладки: полоса заголовков (её строит движок) с линией снизу, выбранный заголовок подчёркнут -->
    <!-- Tabs: the header strip (the engine builds it) with a line at the bottom, the selected header is underlined -->
    <Style name="Tabs" spacing="12"/>
    <Style name="TabBar" orientation="horizontal" spacing="4" borderWidth="0 0 1 0" borderColor="#e4e7ec"/>
    <Style name="TabHeader" padding="8 12" borderWidth="0 0 2 0" borderColor="transparent" borderRadius="6 6 0 0"
           color="#475467" fontWeight="500" cursor="pointer" textWrap="nowrap"
           transition="color 0.15s ease, background 0.15s ease, borderColor 0.15s ease">
      <Hover color="#101828" background="#f2f4f7"/>
      <Focused boxShadow="0 0 0 3 rgba(37, 99, 235, 0.35)"/>
      <Disabled opacity="0.4"/>
      <Checked color="#1d4ed8" borderColor="#2563eb"/>
    </Style>
    <Style name="Tab" grow="1"/>
    <Style name="Scroll" overflow="hidden"/>
    <!-- Всплывающие слои: меню (Popup + MenuItem) и подсказка tooltip (стиль Tooltip ставит движок) -->
    <!-- Popup layers: a menu (Popup + MenuItem) and a tooltip (the engine sets the Tooltip style) -->
    <Style name="Popup" padding="4" spacing="1" minWidth="168" background="#ffffff" color="#101828" borderWidth="1"
           borderColor="#e4e7ec" borderRadius="10" boxShadow="0 10 28 rgba(16, 24, 40, 0.18), 0 2 6 rgba(16, 24, 40, 0.08)"
           fontSize="13.5"/>
    <Style name="MenuItem" padding="7 12" borderRadius="6" cursor="pointer" transition="background 0.1s ease">
      <Hover background="#eef2ff"/>
      <Pressed background="#e0e7ff"/>
      <Focused background="#eef2ff"/>
      <Disabled opacity="0.4"/>
      <Checked color="#1d4ed8"/>
      <Open background="#eef2ff"/>
    </Style>
    <!-- Строка меню окна и её пункты (стиль MenuBarItem движок даёт пунктам MenuItem внутри MenuBar) -->
    <!-- The window menu bar and its items (the engine gives the MenuBarItem style to the MenuItem items inside a MenuBar) -->
    <Style name="MenuBar" orientation="horizontal" spacing="2" padding="3 6" background="#f8f9fb" color="#101828"
           borderWidth="0 0 1 0" borderColor="#e4e7ec" fontSize="13.5"/>
    <Style name="MenuBarItem" padding="4 10" borderRadius="6" cursor="default" textWrap="nowrap"
           transition="background 0.1s ease">
      <Hover background="#eef2ff"/>
      <Focused background="#eef2ff"/>
      <Disabled opacity="0.4"/>
      <Open background="#e0e7ff"/>
    </Style>
    <!-- Панель инструментов: плоские кнопки (стиль ToolBarButton движок даёт Button в ToolBar и ToolGroup), разделители, «ещё» -->
    <!-- A toolbar: flat buttons (the engine gives the ToolBarButton style to Button in ToolBar and ToolGroup), separators, "more" -->
    <Style name="ToolBar" orientation="horizontal" spacing="2" padding="4 6" align="center" background="#ffffff"
           borderWidth="0 0 1 0" borderColor="#e4e7ec" fontSize="13.5"/>
    <Style name="ToolGroup" orientation="horizontal" spacing="2" align="center"/>
    <Style name="Separator" background="#e4e7ec" margin="4" alignSelf="stretch"/>
    <Style name="ToolBarButton" orientation="horizontal" justify="center" align="center" spacing="6" padding="5 8"
           borderRadius="6" color="#344054" textWrap="nowrap" cursor="default" transition="background 0.1s ease">
      <Hover background="#f2f4f7"/>
      <Pressed background="#e4e7ec"/>
      <Focused boxShadow="0 0 0 3 rgba(37, 99, 235, 0.35)"/>
      <Disabled opacity="0.4"/>
      <Checked background="#e0e7ff" color="#1d4ed8"/>
    </Style>
    <Style name="ToolBarMore" padding="5 6" borderRadius="6" color="#344054" cursor="default" transition="background 0.1s ease">
      <Hover background="#f2f4f7"/>
      <Focused boxShadow="0 0 0 3 rgba(37, 99, 235, 0.35)"/>
      <Open background="#e4e7ec"/>
    </Style>
    <!-- Выпадающий список: поле как у Input, справа место под стрелку (её рисует движок) -->
    <!-- A drop-down list: a field like Input, room for the arrow on the right (the engine draws it) -->
    <Style name="ComboBox" basedOn="Input" padding="8 34 8 12" cursor="pointer" textWrap="nowrap" textOverflow="ellipsis"/>
    <!-- Модальный диалог: панель по центру окна, окно под ней затемнено (scrim) -->
    <!-- A modal dialog: a panel in the window center, the window under it is dimmed (scrim) -->
    <Style name="Dialog" padding="24" spacing="16" minWidth="320" maxWidth="560" background="#ffffff" color="#101828"
           borderWidth="1" borderColor="#e4e7ec" borderRadius="14" scrim="rgba(16, 24, 40, 0.45)"
           boxShadow="0 24 48 rgba(16, 24, 40, 0.22), 0 4 12 rgba(16, 24, 40, 0.10)"/>
    <!-- Подложка страницы, пока браузер не готов (или недоступен) / The page backdrop while the browser is not ready (or unavailable) -->
    <Style name="WebView" background="#ffffff" borderWidth="1" borderColor="#e4e7ec"/>
    <Style name="Tooltip" padding="5 9" minWidth="0" spacing="0" background="#1f2937" color="#f9fafb" borderWidth="0"
           borderRadius="6" boxShadow="0 4 12 rgba(0, 0, 0, 0.25)" fontSize="12.5"/>
  </Resources>
  <Box/>
</Window>
