<?xml version="1.0" encoding="UTF-8"?>
<!--
  Схема разметки Gran UI (XML Schema 1.1). Встраивается в библиотеку и проверяет документ
  во время разбора «Берёстой»: лексика значений — типами и шаблонами, ограничения интерфейса —
  утверждениями xs:assert, ссылки на стили и уникальность id — xs:key / xs:keyref / xs:unique.
  Значение вида $имя — ссылка на значение темы (<Theme><Token name="имя" value="…"/>).

  The Gran UI markup schema (XML Schema 1.1). It is embedded into the library and checks a document
  while Beresta parses it: the value lexis by types and patterns, the interface constraints by
  xs:assert assertions, the style references and id uniqueness by xs:key / xs:keyref / xs:unique.
  A value like $name refers to a theme value (<Theme><Token name="name" value="…"/>).
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning"
           vc:minVersion="1.1" elementFormDefault="qualified">

  <!-- ================= Простые типы / Simple types ================= -->

  <!-- Заголовок окна и роли его элементов / The window title bar and its element roles -->
  <xs:simpleType name="TitleBar">
    <xs:restriction base="xs:string">
      <xs:enumeration value="system"/>
      <xs:enumeration value="custom"/>
    </xs:restriction>
  </xs:simpleType>
  <!-- Имена атрибутов через пробел (persist) / Attribute names separated by spaces (persist) -->
  <xs:simpleType name="PersistList">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Za-z][A-Za-z0-9]*( [A-Za-z][A-Za-z0-9]*)*"/>
    </xs:restriction>
  </xs:simpleType>
  <!-- Вид окна: обычное, диалог (без свёртки и развёртки), инструментальное / The window kind: normal, a dialog (without minimize and maximize), a tool one -->
  <xs:simpleType name="WindowKind">
    <xs:restriction base="xs:string">
      <xs:enumeration value="normal"/>
      <xs:enumeration value="dialog"/>
      <xs:enumeration value="tool"/>
    </xs:restriction>
  </xs:simpleType>
  <!-- Начальное место окна; у окна с владельцем default означает centerOwner -->
  <!-- The initial window place; for a window with an owner default means centerOwner -->
  <xs:simpleType name="WindowPosition">
    <xs:restriction base="xs:string">
      <xs:enumeration value="default"/>
      <xs:enumeration value="center"/>
      <xs:enumeration value="centerOwner"/>
    </xs:restriction>
  </xs:simpleType>
  <!-- Ребёнок ToolBar при нехватке места: в меню «ещё» по надобности, всегда или никогда / A ToolBar child when room is short: into the "more" menu as needed, always or never -->
  <xs:simpleType name="OverflowMode">
    <xs:restriction base="xs:string">
      <xs:enumeration value="asNeeded"/>
      <xs:enumeration value="always"/>
      <xs:enumeration value="never"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="WindowRole">
    <xs:restriction base="xs:string">
      <xs:enumeration value="none"/>
      <xs:enumeration value="drag"/>
      <xs:enumeration value="minimize"/>
      <xs:enumeration value="maximize"/>
      <xs:enumeration value="close"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Ссылка на значение темы / A theme value reference -->
  <xs:simpleType name="TokenRef">
    <xs:restriction base="xs:string">
      <xs:pattern value="$[a-zA-Z_][a-zA-Z0-9_\-]*"/>
    </xs:restriction>
  </xs:simpleType>

  <!--
    Выражение привязки {XPath 1.0}: значение вычисляется во время работы и пересчитывается при смене
    зависимостей (переменных $имя, свойств $id.свойство, моделей). Синтаксис проверяет загрузчик.
    A binding expression {XPath 1.0}: the value is computed at run time and recomputed when the dependencies
    change ($name variables, $id.property properties, models). The loader checks the syntax.
  -->
  <xs:simpleType name="Binding">
    <xs:restriction base="xs:string">
      <xs:pattern value="\{.*\}"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Логическое значение или выражение / A boolean or an expression -->
  <xs:simpleType name="BindableBoolean">
    <xs:union memberTypes="xs:boolean Binding"/>
  </xs:simpleType>

  <!-- Число или выражение / A number or an expression -->
  <xs:simpleType name="BindableDecimal">
    <xs:union memberTypes="xs:decimal Binding"/>
  </xs:simpleType>

  <!-- Неотрицательное число (размеры, отступы между детьми) / A non-negative number (sizes, gaps) -->
  <xs:simpleType name="NonNegativeNumber">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Размер в пикселях или ссылка темы / A size in pixels or a theme reference -->
  <xs:simpleType name="Size">
    <xs:union memberTypes="NonNegativeNumber TokenRef Binding"/>
  </xs:simpleType>

  <!-- Число со знаком или ссылка темы / A signed number or a theme reference -->
  <xs:simpleType name="Number">
    <xs:union memberTypes="xs:decimal TokenRef Binding"/>
  </xs:simpleType>

  <!-- Непрозрачность 0..1 / An opacity 0..1 -->
  <xs:simpleType name="UnitInterval">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="1"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Opacity">
    <xs:union memberTypes="UnitInterval TokenRef Binding"/>
  </xs:simpleType>

  <!-- Длина: auto, пиксели, проценты / A length: auto, pixels, percent -->
  <xs:simpleType name="Length">
    <xs:restriction base="xs:string">
      <xs:pattern value="auto|([0-9]+(\.[0-9]*)?|\.[0-9]+)(px|%)?|$[a-zA-Z_][a-zA-Z0-9_\-]*|\{.*\}"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Отступы: 1–4 числа через пробелы или запятые / Insets: 1–4 numbers separated by spaces or commas -->
  <xs:simpleType name="Insets">
    <xs:restriction base="xs:string">
      <xs:pattern value="(-?([0-9]+(\.[0-9]*)?|\.[0-9]+)|$[a-zA-Z_][a-zA-Z0-9_\-]*)([ ,]+(-?([0-9]+(\.[0-9]*)?|\.[0-9]+)|$[a-zA-Z_][a-zA-Z0-9_\-]*)){0,3}|\{.*\}"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Радиусы углов: 1–4 неотрицательных числа / Corner radii: 1–4 non-negative numbers -->
  <xs:simpleType name="Radii">
    <xs:restriction base="xs:string">
      <xs:pattern value="(([0-9]+(\.[0-9]*)?|\.[0-9]+)|$[a-zA-Z_][a-zA-Z0-9_\-]*)([ ,]+(([0-9]+(\.[0-9]*)?|\.[0-9]+)|$[a-zA-Z_][a-zA-Z0-9_\-]*)){0,3}|\{.*\}"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Цвет: #hex, rgb()/rgba()/hsl()/hsla(), имя CSS, ссылка темы / A color: #hex, rgb()/rgba()/hsl()/hsla(), a CSS name, a theme reference -->
  <xs:simpleType name="Color">
    <xs:restriction base="xs:string">
      <xs:pattern value="#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(rgba?|hsla?)\([^()]+\)|[a-zA-Z]+|$[a-zA-Z_][a-zA-Z0-9_\-]*|\{.*\}"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Заливка: none, цвет или градиент CSS / A fill: none, a color or a CSS gradient -->
  <xs:simpleType name="Paint">
    <xs:restriction base="xs:string">
      <xs:pattern value="#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|(rgba?|hsla?)\([^()]+\)|[a-zA-Z]+|$[a-zA-Z_][a-zA-Z0-9_\-]*|(linear|radial|conic)-gradient\(.+\)|\{.*\}"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Тени box-shadow: смысл проверяет парсер (точные сообщения) / box-shadow shadows: the parser checks the meaning -->
  <xs:simpleType name="Shadows">
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Дорожки сетки только через запятые: число дорожек нужно утверждениям Grid -->
  <!-- Grid tracks separated only by commas: the Grid assertions need the track count -->
  <xs:simpleType name="Tracks">
    <xs:restriction base="xs:string">
      <xs:pattern value="(auto|([0-9]+(\.[0-9]*)?|\.[0-9]+)(px|fr)?|minmax\([^(),]+,[^(),]+\))( *, *(auto|([0-9]+(\.[0-9]*)?|\.[0-9]+)(px|fr)?|minmax\([^(),]+,[^(),]+\)))*"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Переходы: "свойство длительность [кривая] [задержка], ..." / Transitions: "property duration [curve] [delay], ..." -->
  <xs:simpleType name="Transitions">
    <xs:restriction base="xs:string">
      <xs:pattern value="[a-zA-Z][a-zA-Z\-]* +[0-9.]+m?s.*"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Анимации по ключевым кадрам: none или «имя длительность …» через запятую; смысл проверяет парсер -->
  <!-- Keyframe animations: none or "name duration …" separated by commas; the parser checks the meaning -->
  <xs:simpleType name="Animations">
    <xs:restriction base="xs:string">
      <xs:pattern value="none|[a-zA-Z][a-zA-Z0-9_\-]* +[0-9.]+m?s.*"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Место ключевого кадра: проценты от 0% до 100% / A keyframe place: percent from 0% to 100% -->
  <xs:simpleType name="KeyframeOffset">
    <xs:restriction base="xs:string">
      <xs:pattern value="([0-9]{1,2}(\.[0-9]+)?|100(\.0+)?)%"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Преобразования: none или функции подряд / Transforms: none or functions in a row -->
  <xs:simpleType name="Transform">
    <xs:restriction base="xs:string">
      <xs:pattern value="none|( *[a-zA-Z]+\([^()]*\) *)+|\{.*\}"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Точка начала преобразования: доли или ключевые слова / The transform origin: fractions or keywords -->
  <xs:simpleType name="Origin">
    <xs:restriction base="xs:string">
      <xs:pattern value="(left|center|right|[0-9.]+%?) +(top|center|bottom|[0-9.]+%?)"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Имя действия приложения или встроенная команда gran:команда:id (у команд и окна).
       An application action name or a built-in gran:command:id command (for commands and the window). -->
  <xs:simpleType name="PlainAction">
    <xs:union memberTypes="xs:NCName">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="gran:(close|minimize|maximize|restore|reload|focus|remove|showDialog|hideDialog|showPopup|hidePopup|navigate|loadHtml|postMessage|appendMarkup|capturePointer|releasePointer|runCommand|enableCommand|disableCommand|undo|redo|clearUndo|setUndoClean|setUndoLimit|setVariable|toggleVariable|expand|collapse|toggle)(:.*)?"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:union>
  </xs:simpleType>

  <!--
    Ссылка на параметр компонента {$имя}: подставляется при развёртывании <Component>; вне тела компонента — ошибка загрузчика.
    A component parameter reference {$name}: substituted when a <Component> is expanded; outside a component body it is a loader error.
  -->
  <xs:simpleType name="ParamRef">
    <xs:restriction base="xs:string">
      <xs:pattern value="\{$[a-zA-Z_][a-zA-Z0-9_\-]*\}"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Действие элемента: ещё и параметр компонента (onClick="{$onOpen}") / An element action: also a component parameter (onClick="{$onOpen}") -->
  <xs:simpleType name="Action">
    <xs:union memberTypes="PlainAction ParamRef"/>
  </xs:simpleType>

  <!-- Сочетание клавиш: модификаторы Mod (= Ctrl), Ctrl, Shift, Alt через «+» и клавиша (S, F5, Enter, Del…);
       имена клавиш и модификаторов проверяет загрузчик. A key combination: the Mod (= Ctrl), Ctrl, Shift, Alt
       modifiers joined by "+" and a key (S, F5, Enter, Del…); the loader checks the key and modifier names. -->
  <xs:simpleType name="ShortcutToken">
    <xs:restriction base="xs:token">
      <xs:pattern value="([A-Za-z]+\+)*[A-Za-z0-9]+"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Несколько сочетаний через пробел (key="Mod+Y Mod+Shift+Z") / Several combinations by spaces (key="Mod+Y Mod+Shift+Z") -->
  <xs:simpleType name="ShortcutList">
    <xs:list itemType="ShortcutToken"/>
  </xs:simpleType>

  <!-- Где действует сочетание команды / Where the command shortcut works -->
  <xs:simpleType name="CommandScope">
    <xs:restriction base="xs:token">
      <xs:enumeration value="window"/>
      <xs:enumeration value="focus"/>
      <xs:enumeration value="global"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Свои события: пары «имя:действие» через пробелы (on="itemChosen:pick rowMoved:gran:reload").
       Custom events: "name:action" pairs by spaces (on="itemChosen:pick rowMoved:gran:reload"). -->
  <xs:simpleType name="CustomEvents">
    <xs:restriction base="xs:string">
      <xs:pattern value="\s*[A-Za-z_][A-Za-z0-9_.\-]*:\S+(\s+[A-Za-z_][A-Za-z0-9_.\-]*:\S+)*\s*"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Форматы, которые принимает зона перетаскивания (через пробелы; * — любой) / The formats a drop zone accepts (by spaces; * — any) -->
  <xs:simpleType name="DragFormats">
    <xs:restriction base="xs:string">
      <xs:pattern value="\s*(\*|[A-Za-z_][A-Za-z0-9_.\-]*)(\s+(\*|[A-Za-z_][A-Za-z0-9_.\-]*))*\s*"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Orientation">
    <xs:restriction base="xs:token">
      <xs:enumeration value="horizontal"/>
      <xs:enumeration value="vertical"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Justify">
    <xs:restriction base="xs:token">
      <xs:enumeration value="start"/>
      <xs:enumeration value="center"/>
      <xs:enumeration value="end"/>
      <xs:enumeration value="space-between"/>
      <xs:enumeration value="space-around"/>
      <xs:enumeration value="space-evenly"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Align">
    <xs:restriction base="xs:token">
      <xs:enumeration value="start"/>
      <xs:enumeration value="center"/>
      <xs:enumeration value="end"/>
      <xs:enumeration value="stretch"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="AlignSelf">
    <xs:restriction base="xs:token">
      <xs:enumeration value="auto"/>
      <xs:enumeration value="start"/>
      <xs:enumeration value="center"/>
      <xs:enumeration value="end"/>
      <xs:enumeration value="stretch"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TextAlign">
    <xs:restriction base="xs:token">
      <xs:enumeration value="start"/>
      <xs:enumeration value="center"/>
      <xs:enumeration value="end"/>
      <xs:enumeration value="justify"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Overflow">
    <xs:restriction base="xs:token">
      <xs:enumeration value="visible"/>
      <xs:enumeration value="hidden"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Cursor">
    <xs:restriction base="xs:token">
      <xs:enumeration value="default"/>
      <xs:enumeration value="pointer"/>
      <xs:enumeration value="text"/>
      <xs:enumeration value="move"/>
      <xs:enumeration value="not-allowed"/>
      <xs:enumeration value="grab"/>
      <xs:enumeration value="ew-resize"/>
      <xs:enumeration value="ns-resize"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ImageFit">
    <xs:restriction base="xs:token">
      <xs:enumeration value="fill"/>
      <xs:enumeration value="contain"/>
      <xs:enumeration value="cover"/>
      <xs:enumeration value="none"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ScrollDirection">
    <xs:restriction base="xs:token">
      <xs:enumeration value="vertical"/>
      <xs:enumeration value="horizontal"/>
      <xs:enumeration value="both"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Клавиша отправки TextArea: ctrlEnter — Ctrl+Enter, enter — Enter (Shift+Enter — новая строка) -->
  <!-- The TextArea submit key: ctrlEnter — Ctrl+Enter, enter — Enter (Shift+Enter is a new line) -->
  <xs:simpleType name="SubmitKey">
    <xs:restriction base="xs:token">
      <xs:enumeration value="ctrlEnter"/>
      <xs:enumeration value="enter"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="FontStyle">
    <xs:restriction base="xs:token">
      <xs:enumeration value="normal"/>
      <xs:enumeration value="italic"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="FontWeightName">
    <xs:restriction base="xs:token">
      <xs:enumeration value="normal"/>
      <xs:enumeration value="bold"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="FontWeightNumber">
    <xs:restriction base="xs:integer">
      <xs:minInclusive value="1"/>
      <xs:maxInclusive value="1000"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="FontWeight">
    <xs:union memberTypes="FontWeightName FontWeightNumber"/>
  </xs:simpleType>

  <xs:simpleType name="TextWrap">
    <xs:restriction base="xs:token">
      <xs:enumeration value="wrap"/>
      <xs:enumeration value="nowrap"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Линия оформления: подчёркивание (ссылки) или зачёркивание / The decoration line: an underline (links) or a line-through -->
  <xs:simpleType name="TextDecoration">
    <xs:restriction base="xs:token">
      <xs:enumeration value="none"/>
      <xs:enumeration value="underline"/>
      <xs:enumeration value="lineThrough"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TextOverflow">
    <xs:restriction base="xs:token">
      <xs:enumeration value="clip"/>
      <xs:enumeration value="ellipsis"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ================= Группы атрибутов / Attribute groups ================= -->

  <!-- Размер и место блока в родителе / The box size and its place in the parent -->
  <!--
    События элемента (Application::onEvent, обработчик получает ui::UiEvent): клавиши, указатель, двойной щелчок,
    колесо, фокус, контекстное меню, перетаскивание узлов. Суффикс Capture — фаза захвата (от корня к цели).
    onDrop — сброс узла (если acceptDrop принимает формат) и файлов из Проводника (Application::onFileDrop).
    on — свои события «имя:действие». draggable — узел можно тащить (данные dragFormat/dragData, по умолчанию
    "node" и id); acceptDrop — форматы, которые узел принимает как зона.
    The element events (Application::onEvent, the handler gets a ui::UiEvent): keys, the pointer, a double click,
    the wheel, the focus, the context menu, dragging nodes. The Capture suffix is the capture phase (from the root to the target).
    onDrop is a node drop (if acceptDrop accepts the format) and files from Explorer (Application::onFileDrop).
    on is custom "name:action" events. draggable — the node can be dragged (the dragFormat/dragData data, by default
    "node" and the id); acceptDrop — the formats the node accepts as a zone.
  -->
  <xs:attributeGroup name="EventAttributes">
    <xs:attribute name="onKeyDown" type="Action"/>
    <xs:attribute name="onKeyDownCapture" type="Action"/>
    <xs:attribute name="onKeyUp" type="Action"/>
    <xs:attribute name="onKeyUpCapture" type="Action"/>
    <xs:attribute name="onPointerDown" type="Action"/>
    <xs:attribute name="onPointerDownCapture" type="Action"/>
    <xs:attribute name="onPointerMove" type="Action"/>
    <xs:attribute name="onPointerMoveCapture" type="Action"/>
    <xs:attribute name="onPointerUp" type="Action"/>
    <xs:attribute name="onPointerUpCapture" type="Action"/>
    <xs:attribute name="onPointerEnter" type="Action"/>
    <xs:attribute name="onPointerEnterCapture" type="Action"/>
    <xs:attribute name="onPointerLeave" type="Action"/>
    <xs:attribute name="onPointerLeaveCapture" type="Action"/>
    <xs:attribute name="onDoubleClick" type="Action"/>
    <xs:attribute name="onDoubleClickCapture" type="Action"/>
    <xs:attribute name="onWheel" type="Action"/>
    <xs:attribute name="onWheelCapture" type="Action"/>
    <xs:attribute name="onFocus" type="Action"/>
    <xs:attribute name="onFocusCapture" type="Action"/>
    <xs:attribute name="onBlur" type="Action"/>
    <xs:attribute name="onBlurCapture" type="Action"/>
    <xs:attribute name="onContextMenu" type="Action"/>
    <xs:attribute name="onContextMenuCapture" type="Action"/>
    <xs:attribute name="onDragStart" type="Action"/>
    <xs:attribute name="onDragStartCapture" type="Action"/>
    <xs:attribute name="onDragEnter" type="Action"/>
    <xs:attribute name="onDragEnterCapture" type="Action"/>
    <xs:attribute name="onDragOver" type="Action"/>
    <xs:attribute name="onDragOverCapture" type="Action"/>
    <xs:attribute name="onDragLeave" type="Action"/>
    <xs:attribute name="onDragLeaveCapture" type="Action"/>
    <xs:attribute name="onDrop" type="Action"/>
    <xs:attribute name="onDropCapture" type="Action"/>
    <xs:attribute name="onDragEnd" type="Action"/>
    <xs:attribute name="onDragEndCapture" type="Action"/>
    <xs:attribute name="on" type="CustomEvents"/>
    <xs:attribute name="draggable" type="xs:boolean"/>
    <xs:attribute name="dragFormat" type="xs:NCName"/>
    <xs:attribute name="dragData" type="xs:string"/>
    <xs:attribute name="acceptDrop" type="DragFormats"/>
  </xs:attributeGroup>

  <xs:attributeGroup name="BoxAttributes">
    <xs:attribute name="width" type="Length"/>
    <xs:attribute name="height" type="Length"/>
    <xs:attribute name="minWidth" type="Size"/>
    <xs:attribute name="maxWidth" type="Size"/>
    <xs:attribute name="minHeight" type="Size"/>
    <xs:attribute name="maxHeight" type="Size"/>
    <xs:attribute name="margin" type="Insets"/>
    <xs:attribute name="padding" type="Insets"/>
    <xs:attribute name="grow" type="NonNegativeNumber"/>
    <xs:attribute name="shrink" type="NonNegativeNumber"/>
    <xs:attribute name="alignSelf" type="AlignSelf"/>
    <xs:attribute name="gridRow" type="xs:nonNegativeInteger"/>
    <xs:attribute name="gridColumn" type="xs:nonNegativeInteger"/>
    <xs:attribute name="gridRowSpan" type="xs:positiveInteger"/>
    <xs:attribute name="gridColumnSpan" type="xs:positiveInteger"/>
    <xs:attribute name="left" type="Number"/>
    <xs:attribute name="top" type="Number"/>
    <xs:attribute name="right" type="Number"/>
    <xs:attribute name="bottom" type="Number"/>
    <xs:attribute name="zIndex" type="xs:integer"/>
  </xs:attributeGroup>

  <!-- Внешний вид (разрешён и в состояниях) / The appearance (also allowed in states) -->
  <xs:attributeGroup name="VisualAttributes">
    <xs:attribute name="background" type="Paint"/>
    <xs:attribute name="borderColor" type="Color"/>
    <xs:attribute name="borderWidth" type="Radii"/>
    <xs:attribute name="borderRadius" type="Radii"/>
    <xs:attribute name="boxShadow" type="Shadows"/>
    <xs:attribute name="opacity" type="Opacity"/>
    <xs:attribute name="transform" type="Transform"/>
    <xs:attribute name="transformOrigin" type="Origin"/>
    <xs:attribute name="backdropBlur" type="Size"/>
    <xs:attribute name="cursor" type="Cursor"/>
    <!-- Затемнение окна под диалогом (действует у Dialog) / The window dimming under a dialog (acts on Dialog) -->
    <xs:attribute name="scrim" type="Color"/>
  </xs:attributeGroup>

  <!-- Текст: наследуется от родителя, как в CSS / Text: inherited from the parent, as in CSS -->
  <xs:attributeGroup name="TextAttributes">
    <xs:attribute name="color" type="Color"/>
    <xs:attribute name="fontFamily" type="xs:string"/>
    <xs:attribute name="fontSize" type="Size"/>
    <xs:attribute name="fontWeight" type="FontWeight"/>
    <xs:attribute name="fontStyle" type="FontStyle"/>
    <xs:attribute name="lineHeight" type="Size"/>
    <xs:attribute name="letterSpacing" type="Number"/>
    <xs:attribute name="textAlign" type="TextAlign"/>
    <xs:attribute name="textWrap" type="TextWrap"/>
    <xs:attribute name="textOverflow" type="TextOverflow"/>
    <xs:attribute name="maxLines" type="xs:positiveInteger"/>
    <xs:attribute name="textDecoration" type="TextDecoration"/>
    <xs:attribute name="accentColor" type="Color"/>
  </xs:attributeGroup>

  <!-- Расположение детей стека / The stack children arrangement -->
  <xs:attributeGroup name="StackAttributes">
    <xs:attribute name="orientation" type="Orientation"/>
    <xs:attribute name="spacing" type="Size"/>
    <xs:attribute name="justify" type="Justify"/>
    <xs:attribute name="align" type="Align"/>
    <xs:attribute name="wrap" type="xs:boolean"/>
  </xs:attributeGroup>

  <!-- Дорожки сетки / The grid tracks -->
  <xs:attributeGroup name="GridAttributes">
    <xs:attribute name="rows" type="Tracks"/>
    <xs:attribute name="columns" type="Tracks"/>
    <xs:attribute name="rowSpacing" type="Size"/>
    <xs:attribute name="columnSpacing" type="Size"/>
  </xs:attributeGroup>

  <!-- Всё, что можно задать стилем / Everything a style can set -->
  <xs:attributeGroup name="StyleAttributes">
    <xs:attributeGroup ref="BoxAttributes"/>
    <xs:attributeGroup ref="VisualAttributes"/>
    <xs:attributeGroup ref="TextAttributes"/>
    <xs:attributeGroup ref="StackAttributes"/>
    <xs:attributeGroup ref="GridAttributes"/>
    <xs:attribute name="overflow" type="Overflow"/>
    <xs:attribute name="transition" type="Transitions"/>
    <xs:attribute name="animation" type="Animations"/>
  </xs:attributeGroup>

  <!-- ================= Состояния / States ================= -->

  <!-- Состояние меняет только вид, не компоновку: hover никогда не двигает соседей -->
  <!-- A state changes only the look, not the layout: hover never moves the neighbours -->
  <xs:complexType name="StateType">
    <xs:attributeGroup ref="VisualAttributes"/>
    <xs:attributeGroup ref="TextAttributes"/>
    <xs:attribute name="animation" type="Animations"/>
    <!-- Выражения {…} — только у элементов интерфейса: стиль и кадр общие для многих узлов / {…} expressions are only for UI elements: a style and a frame are shared by many nodes -->
    <xs:assert test="every $a in @* satisfies not(starts-with($a, '{'))"/>
  </xs:complexType>

  <xs:group name="States">
    <xs:sequence>
      <xs:element name="Hover" type="StateType" minOccurs="0"/>
      <xs:element name="Pressed" type="StateType" minOccurs="0"/>
      <xs:element name="Focused" type="StateType" minOccurs="0"/>
      <!-- Копия записи отмечена моделью выделения списка (selection="…") / The record copy is marked by the list selection model (selection="…") -->
      <xs:element name="Selected" type="StateType" minOccurs="0"/>
      <xs:element name="Disabled" type="StateType" minOccurs="0"/>
      <xs:element name="Checked" type="StateType" minOccurs="0"/>
      <!-- Окно развёрнуто (для кнопок заголовка) / The window is maximized (for the title bar buttons) -->
      <xs:element name="Maximized" type="StateType" minOccurs="0"/>
      <!-- Над зоной onDrop несут файлы или узел, который она примет / Files or a node it accepts are carried over an onDrop zone -->
      <xs:element name="DropTarget" type="StateType" minOccurs="0"/>
      <!-- Узел сейчас перетаскивают (draggable) / The node is being dragged now (draggable) -->
      <xs:element name="Dragging" type="StateType" minOccurs="0"/>
      <!-- Слой элемента открыт: меню пункта строки меню, подменю / The element layer is open: the menu of a menu bar item, a submenu -->
      <xs:element name="Open" type="StateType" minOccurs="0"/>
    </xs:sequence>
  </xs:group>

  <!-- ================= Элементы интерфейса / UI elements ================= -->

  <xs:group name="UiElement">
    <xs:choice>
      <xs:element name="Stack" type="StackType"/>
      <xs:element name="Box" type="StackType"/>
      <xs:element name="Grid" type="GridType"/>
      <xs:element name="Canvas" type="CanvasType"/>
      <xs:element name="Scroll" type="ScrollType"/>
      <xs:element name="Text" type="TextType"/>
      <xs:element name="Image" type="ImageType"/>
      <xs:element name="Icon" type="IconType"/>
      <xs:element name="Button" type="ButtonType"/>
      <xs:element name="Input" type="InputType"/>
      <xs:element name="CheckBox" type="CheckBoxType"/>
      <xs:element name="Slider" type="SliderType"/>
      <xs:element name="TextArea" type="TextAreaType"/>
      <xs:element name="Popup" type="PopupType"/>
      <xs:element name="MenuItem" type="MenuItemType"/>
      <xs:element name="WebView" type="WebViewType"/>
      <xs:element name="Dialog" type="DialogType"/>
      <xs:element name="ComboBox" type="ComboBoxType"/>
      <xs:element name="RadioButton" type="RadioButtonType"/>
      <xs:element name="Switch" type="CheckBoxType"/>
      <xs:element name="ProgressBar" type="ProgressBarType"/>
      <xs:element name="Tabs" type="TabsType"/>
      <xs:element name="MenuBar" type="MenuBarType"/>
      <xs:element name="ToolBar" type="ToolBarType"/>
      <xs:element name="ToolGroup" type="ToolBarType"/>
      <xs:element name="Separator" type="SeparatorType"/>
      <!-- Место для содержимого экземпляра — только в теле <Component> / A place for the instance content — only in a <Component> body -->
      <xs:element name="Slot" type="SlotType"/>
      <!--
        Экземпляр компонента из библиотеки (<c:Card xmlns:c="urn:…">): его проверяет схема, которую
        загрузчик генерирует по <Library>; здесь — только «элемент другого пространства имён».
        A library component instance (<c:Card xmlns:c="urn:…">): the schema the loader generates
        from the <Library> checks it; here it is only "an element of another namespace".
      -->
      <xs:any namespace="##other" processContents="lax"/>
    </xs:choice>
  </xs:group>

  <!--
    Основа всех элементов. mixed="true" нужен Text и Button (текст внутри тега); контейнерам
    текст запрещают утверждения типов-контейнеров. Утверждения основы наследуются всеми элементами.
    The base of all elements. mixed="true" is needed by Text and Button (text inside the tag);
    the container type assertions forbid text in containers. The base assertions are inherited by all elements.
  -->
  <xs:complexType name="ElementBase" mixed="true">
    <xs:group ref="States"/>
    <xs:attribute name="id" type="xs:NCName"/>
    <xs:attribute name="style" type="xs:NCName"/>
    <xs:attribute name="visible" type="BindableBoolean"/>
    <xs:attribute name="enabled" type="BindableBoolean"/>
    <xs:attribute name="windowRole" type="WindowRole"/>
    <xs:attribute name="overflowMode" type="OverflowMode"/>
    <!-- Атрибуты узла, которые хранятся в настройках программы (имена через пробел; нужен id и layout у окна) -->
    <!-- The node attributes kept in the program settings (names separated by spaces; an id and the window layout are needed) -->
    <xs:attribute name="persist" type="PersistList"/>
    <xs:attribute name="tooltip" type="xs:string"/>
    <!-- Имя для дикторов (как aria-label) и id элемента-подписи (как aria-labelledby) -->
    <!-- The name for screen readers (as aria-label) and the id of the label element (as aria-labelledby) -->
    <xs:attribute name="accessibleName" type="xs:string"/>
    <xs:attribute name="labeledBy" type="xs:NCName"/>
    <!-- Именованный слот компонента, куда идёт этот ребёнок экземпляра / The named component slot this instance child goes to -->
    <xs:attribute name="slot" type="xs:NCName"/>
    <xs:attribute name="onClick" type="Action"/>
    <xs:attributeGroup ref="EventAttributes"/>
    <xs:attribute name="overflow" type="Overflow"/>
    <xs:attribute name="transition" type="Transitions"/>
    <xs:attribute name="animation" type="Animations"/>
    <xs:attributeGroup ref="BoxAttributes"/>
    <xs:attributeGroup ref="VisualAttributes"/>
    <xs:attributeGroup ref="TextAttributes"/>
    <!-- Минимум не больше максимума (ссылки темы проверяются после подстановки) -->
    <!-- The minimum is not above the maximum (theme references are checked after substitution) -->
    <xs:assert test="not(@minWidth and @maxWidth) or starts-with(@minWidth, '$') or starts-with(@maxWidth, '$')
                     or starts-with(@minWidth, '{') or starts-with(@maxWidth, '{')
                     or number(@minWidth) &lt;= number(@maxWidth)"/>
    <xs:assert test="not(@minHeight and @maxHeight) or starts-with(@minHeight, '$') or starts-with(@maxHeight, '$')
                     or starts-with(@minHeight, '{') or starts-with(@maxHeight, '{')
                     or number(@minHeight) &lt;= number(@maxHeight)"/>
    <!-- Канвас задаёт либо left, либо right (иначе ширина неоднозначна вместе с width) -->
    <!-- A canvas child sets left or right, not both together with width (the width would be ambiguous) -->
    <xs:assert test="not(@left and @right and @width)"/>
    <xs:assert test="not(@top and @bottom and @height)"/>
  </xs:complexType>

  <!--
    Шаблон одной записи списка: ровно один элемент интерфейса. Подстановки {поле} разрешены
    в текстовых атрибутах (text, placeholder, source, tooltip, accessibleName, dragData, value у MenuItem) и в тексте тегов.
    The template of one list record: exactly one UI element. {field} placeholders are allowed
    in the text attributes (text, placeholder, source, tooltip, accessibleName, dragData, value of MenuItem) and in the tag text.
  -->
  <xs:complexType name="ItemTemplateType">
    <xs:group ref="UiElement"/>
  </xs:complexType>

  <!--
    Общая основа контейнеров: к ElementBase добавляет модель «любые элементы интерфейса»
    и список из данных (items="модель" + <ItemTemplate> — только вместе).
    Текст внутри тега контейнеры запрещают сами (Button его разрешает).
    The common container base: adds the "any UI elements" model to ElementBase
    and a list from data (items="model" + <ItemTemplate> — only together).
    Containers forbid text inside the tag themselves (Button allows it).
  -->
  <xs:complexType name="ContainerBase" mixed="true">
    <xs:complexContent>
      <xs:extension base="ElementBase">
        <xs:sequence>
          <xs:group ref="UiElement" minOccurs="0" maxOccurs="unbounded"/>
          <xs:element name="ItemTemplate" type="ItemTemplateType" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="items" type="ModelName"/>
        <!-- Модель выделения того же списка: щелчок и клавиши выделяют записи, копии получают состояние Selected -->
        <!-- A selection model of the same list: a click and keys select records, the copies get the Selected state -->
        <xs:attribute name="selection" type="ModelName"/>
        <!-- Виртуальный список: копии только у видимых записей (нужен items, записи примерно одной высоты) -->
        <!-- A virtual list: copies only for the visible records (needs items, records of about the same height) -->
        <xs:attribute name="virtual" type="xs:boolean"/>
        <xs:assert test="exists(@items) = exists(ItemTemplate)"/>
        <xs:assert test="not(@virtual = 'true' or @virtual = '1') or exists(@items)"/>
        <xs:assert test="not(@selection) or exists(@items)"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="CanvasType" mixed="true">
    <xs:complexContent>
      <xs:extension base="ContainerBase">
        <xs:assert test="not(text()[normalize-space(.)])"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="StackType" mixed="true">
    <xs:complexContent>
      <xs:extension base="ContainerBase">
        <xs:attributeGroup ref="StackAttributes"/>
        <xs:assert test="not(text()[normalize-space(.)])"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <!--
    Сетка: строка и столбец ребёнка (с учётом span) помещаются в объявленные дорожки.
    Число дорожек = число запятых − число '(' (у каждой minmax одна запятая внутри) + 1.
    A grid: a child's row and column (with span) fit into the declared tracks.
    The track count = the comma count − the '(' count (each minmax has one comma inside) + 1.
  -->
  <xs:complexType name="GridType" mixed="true">
    <xs:complexContent>
      <xs:extension base="ContainerBase">
        <xs:attributeGroup ref="GridAttributes"/>
        <xs:assert test="not(text()[normalize-space(.)])"/>
        <xs:assert test="every $c in * satisfies (not($c/@gridRow) or
            $c/@gridRow + (if ($c/@gridRowSpan) then $c/@gridRowSpan else 1)
            &lt;= string-length(@rows) - string-length(translate(@rows, ',', ''))
               - (string-length(@rows) - string-length(translate(@rows, '(', ''))) + 1)"/>
        <xs:assert test="every $c in * satisfies (not($c/@gridColumn) or
            $c/@gridColumn + (if ($c/@gridColumnSpan) then $c/@gridColumnSpan else 1)
            &lt;= string-length(@columns) - string-length(translate(@columns, ',', ''))
               - (string-length(@columns) - string-length(translate(@columns, '(', ''))) + 1)"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <!-- Прокрутка: ровно один элемент содержимого / A scroll: exactly one content element -->
  <xs:complexType name="ScrollType" mixed="true">
    <xs:complexContent>
      <xs:extension base="ElementBase">
        <xs:group ref="UiElement"/>
        <xs:attribute name="direction" type="ScrollDirection"/>
        <xs:assert test="not(text()[normalize-space(.)])"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <!--
    Текст: из атрибута value или из содержимого тега, но не из обоих. Содержимое может состоять
    из участков <Span> (жирный, моноширинный, цвет, ссылка onClick) вперемешку с обычным текстом.
    Text: from the value attribute or from the tag content, but not from both. The content may consist
    of <Span> runs (bold, monospace, a color, an onClick link) mixed with plain text.
  -->
  <xs:complexType name="TextType" mixed="true">
    <xs:complexContent>
      <xs:extension base="ElementBase">
        <xs:sequence>
          <xs:element name="Span" type="SpanType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="value" type="xs:string"/>
        <xs:assert test="not(@value and normalize-space(.) != '')"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <!--
    Участок текста: только текст и состояния (Hover у ссылки); свойства блока (размеры, отступы,
    рамки) у участка не действуют — он часть строки, а не блок.
    A text run: text and states only (Hover of a link); the box properties (sizes, paddings,
    borders) do not act on a run — it is a part of a line, not a box.
  -->
  <xs:complexType name="SpanType" mixed="true">
    <xs:sequence>
      <xs:group ref="States"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:NCName"/>
    <xs:attribute name="style" type="xs:NCName"/>
    <xs:attribute name="tooltip" type="xs:string"/>
    <xs:attribute name="onClick" type="Action"/>
    <xs:attribute name="background" type="Paint"/>
    <xs:attribute name="cursor" type="Cursor"/>
    <xs:attributeGroup ref="TextAttributes"/>
  </xs:complexType>

  <xs:complexType name="ImageType" mixed="true">
    <xs:complexContent>
      <xs:extension base="ElementBase">
        <xs:attribute name="source" type="xs:string" use="required"/>
        <xs:attribute name="fit" type="ImageFit"/>
        <xs:assert test="not(text()[normalize-space(.)])"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <!--
    Векторная иконка: путь SVG (data, в системе координат viewBox, по умолчанию 0 0 24 24) или файл .svg
    (source). Цвет — свойство color (как у текста), размер по умолчанию — размер viewBox.
    A vector icon: an SVG path (data, in the viewBox coordinate system, 0 0 24 24 by default) or an .svg file
    (source). The color is the color property (as for text), the default size is the viewBox size.
  -->
  <xs:simpleType name="FillRule">
    <xs:restriction base="xs:string">
      <xs:enumeration value="nonzero"/>
      <xs:enumeration value="evenodd"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="IconType" mixed="true">
    <xs:complexContent>
      <xs:extension base="ElementBase">
        <xs:attribute name="data" type="xs:string"/>
        <xs:attribute name="source" type="xs:string"/>
        <xs:attribute name="viewBox" type="xs:string"/>
        <xs:attribute name="fillRule" type="FillRule"/>
        <!-- Ровно один источник; viewBox и fillRule — только у data (у файла они свои) -->
        <!-- Exactly one source; viewBox and fillRule — only with data (a file has its own) -->
        <xs:assert test="(@data and not(@source)) or (@source and not(@data))"/>
        <xs:assert test="@data or (not(@viewBox) and not(@fillRule))"/>
        <xs:assert test="not(text()[normalize-space(.)])"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <!--
    Кнопка: подпись из text, из текста тега или из детей (значок + подпись). popup — id слоя
    (Popup или Dialog), который кнопка открывает сама: щелчком, Enter, пробелом и стрелкой вниз.
    A button: the label from text, from the tag text or from children (an icon + a label). popup is the id of the layer
    (a Popup or a Dialog) the button opens by itself: by a click, Enter, space and the down arrow.
  -->
  <xs:complexType name="ButtonType" mixed="true">
    <xs:complexContent>
      <xs:extension base="ContainerBase">
        <xs:attribute name="text" type="xs:string"/>
        <xs:attribute name="popup" type="xs:NCName"/>
        <xs:attribute name="command" type="xs:NCName"/>
        <xs:attributeGroup ref="StackAttributes"/>
        <!-- enabled кнопки с командой задаёт команда / The enabled of a button with a command is set by the command -->
        <xs:assert test="not(@command and @enabled)"/>
        <xs:assert test="@text or @command or text()[normalize-space(.)] or *[not(self::Hover or self::Pressed
                         or self::Focused or self::Selected or self::Disabled or self::Checked or self::Maximized
                         or self::DropTarget or self::Dragging or self::Open)]"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <!-- Поле ввода: длина значения не больше maxLength / An input: the value length is not above maxLength -->
  <xs:complexType name="InputType" mixed="true">
    <xs:complexContent>
      <xs:extension base="ElementBase">
        <xs:attribute name="value" type="xs:string"/>
        <xs:attribute name="placeholder" type="xs:string"/>
        <xs:attribute name="maxLength" type="xs:positiveInteger"/>
        <xs:attribute name="password" type="xs:boolean"/>
        <xs:attribute name="readOnly" type="xs:boolean"/>
        <!-- false — правки поля не попадают в историю отмены / false — the field edits do not go to the undo history -->
        <xs:attribute name="undo" type="xs:boolean"/>
        <xs:attribute name="onChange" type="Action"/>
        <xs:attribute name="onSubmit" type="Action"/>
        <xs:assert test="not(@maxLength) or not(@value) or string-length(@value) &lt;= @maxLength"/>
        <xs:assert test="not(text()[normalize-space(.)])"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <!--
    Многострочное поле: значение из value или из текста тега (переводы строк сохраняются), не из обоих;
    rows — наименьшая высота в строках, дальше поле растёт по содержимому до maxHeight и прокручивается.
    A multi-line input: the value from value or from the tag text (line breaks are kept), not from both;
    rows is the least height in lines, beyond it the field grows with the content up to maxHeight and scrolls.
  -->
  <xs:complexType name="TextAreaType" mixed="true">
    <xs:complexContent>
      <xs:extension base="ElementBase">
        <xs:attribute name="value" type="xs:string"/>
        <xs:attribute name="placeholder" type="xs:string"/>
        <xs:attribute name="maxLength" type="xs:positiveInteger"/>
        <xs:attribute name="readOnly" type="xs:boolean"/>
        <!-- false — правки поля не попадают в историю отмены / false — the field edits do not go to the undo history -->
        <xs:attribute name="undo" type="xs:boolean"/>
        <xs:attribute name="rows" type="xs:positiveInteger"/>
        <xs:attribute name="submitKey" type="SubmitKey"/>
        <xs:attribute name="onChange" type="Action"/>
        <xs:attribute name="onSubmit" type="Action"/>
        <xs:assert test="not(@value and text()[normalize-space(.)])"/>
        <xs:assert test="not(@maxLength) or not(@value) or string-length(@value) &lt;= @maxLength"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <!--
    Всплывающий слой: скрыт, пока код не откроет его (Application::showPopup у узла или в точке);
    в компоновке родителя не участвует, рисуется поверх всего. Закрывается Esc и щелчком мимо.
    A popup layer: hidden until the code opens it (Application::showPopup at a node or at a point);
    it does not take part in the parent layout and is painted over everything. Esc and a click outside close it.
  -->
  <xs:complexType name="PopupType" mixed="true">
    <xs:complexContent>
      <xs:extension base="ContainerBase">
        <xs:attributeGroup ref="StackAttributes"/>
        <xs:assert test="not(text()[normalize-space(.)])"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <!--
    Пункт меню: подпись text, действие onClick; выбор закрывает меню. Вложенный <Popup> — подменю:
    открывается сбоку (наведением, стрелкой вправо, Enter), пункт с подменю сам команду не выполняет.
    value — значение пункта в ComboBox (без него значение — подпись). В меню и строке меню «_» перед буквой
    подписи — буква доступа («_Открыть…»: в открытом меню клавиша О выбирает пункт), «__» — сам знак «_».
    A menu item: the text label, the onClick action; choosing it closes the menu. A nested <Popup> is a submenu:
    it opens at the side (by hovering, the right arrow, Enter), an item with a submenu runs no command itself.
    value is the item value in a ComboBox (without it the value is the label). In a menu and a menu bar "_" before
    a label letter is the access letter ("_Open…": in an open menu the O key chooses the item), "__" is the "_" sign itself.
  -->
  <xs:complexType name="MenuItemType" mixed="true">
    <xs:complexContent>
      <xs:extension base="ElementBase">
        <xs:sequence>
          <xs:element name="Popup" type="PopupType" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="text" type="xs:string"/>
        <xs:attribute name="value" type="xs:string"/>
        <xs:attribute name="command" type="xs:NCName"/>
        <xs:assert test="not(text()[normalize-space(.)])"/>
        <!-- Подпись — своя или команды; пункт с подменю команду не выполняет; enabled задаёт команда
             The label is its own or the command one; an item with a submenu runs no command; the command sets enabled -->
        <xs:assert test="@text or @command"/>
        <xs:assert test="not(@command and Popup)"/>
        <xs:assert test="not(@command and @enabled)"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <!--
    Строка меню окна: пункты <MenuItem text="_Файл"> с подменю <Popup> (или с командой — пункт без меню).
    Alt (нажать и отпустить) или F10 — фокус на строку, стрелки влево/вправо — соседний пункт, вниз и Enter —
    открыть меню, Alt+буква — сразу открыть меню с этой буквой доступа («_» перед буквой в text), Esc — назад.
    A window menu bar: the items <MenuItem text="_File"> with a <Popup> submenu (or with a command — an item without a menu).
    Alt (press and release) or F10 — the focus to the bar, the left/right arrows — the neighbor item, down and Enter —
    open the menu, Alt+letter — open the menu with this access letter at once ("_" before the letter in text), Esc — back.
  -->
  <!--
    Панель инструментов (и группа внутри неё — ToolGroup): ряд кнопок (обычно Button command="…"), разделителей
    Separator и групп. Не хватает места — хвост уходит в меню кнопки «ещё» (её строит движок) пунктами с теми же
    командами; overflowMode у ребёнка: asNeeded (по умолчанию), always (всегда в меню), never (всегда в панели).
    A toolbar (and a group inside it — ToolGroup): a row of buttons (usually Button command="…"), Separator separators
    and groups. When room is short the tail goes into the menu of the "more" button (the engine builds it) as items with the same
    commands; overflowMode of a child: asNeeded (the default), always (always in the menu), never (always in the bar).
  -->
  <xs:complexType name="ToolBarType" mixed="true">
    <xs:complexContent>
      <xs:extension base="ContainerBase">
        <xs:attributeGroup ref="StackAttributes"/>
        <xs:assert test="not(text()[normalize-space(.)])"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <!-- Разделитель: линия в пиксель поперёк ряда (в панели — вертикальная, в меню — горизонтальная) / A separator: a one pixel line across the row (vertical in a bar, horizontal in a menu) -->
  <xs:complexType name="SeparatorType" mixed="true">
    <xs:complexContent>
      <xs:extension base="ElementBase">
        <xs:assert test="not(text()[normalize-space(.)])"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="MenuBarType" mixed="true">
    <xs:complexContent>
      <xs:extension base="ElementBase">
        <xs:sequence>
          <xs:element name="MenuItem" type="MenuItemType" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attributeGroup ref="StackAttributes"/>
        <xs:assert test="not(text()[normalize-space(.)])"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <!--
    Модальный диалог: скрыт, пока код не откроет его (Application::showDialog) или кнопка с popup="id".
    Встаёт по центру окна, окно под ним затемняется (свойство scrim), ввод вне диалога заблокирован,
    Tab ходит только внутри. closable="false" — Esc диалог не закрывает.
    A modal dialog: hidden until the code opens it (Application::showDialog) or a button with popup="id".
    It stands in the window center, the window under it is dimmed (the scrim property), the input outside the dialog
    is blocked, Tab moves only inside. closable="false" — Esc does not close the dialog.
  -->
  <xs:complexType name="DialogType" mixed="true">
    <xs:complexContent>
      <xs:extension base="ContainerBase">
        <xs:attributeGroup ref="StackAttributes"/>
        <xs:attribute name="closable" type="xs:boolean"/>
        <xs:assert test="not(text()[normalize-space(.)])"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <!--
    Выпадающий список: пункты <MenuItem value text> или items + <ItemTemplate> с MenuItem (только вместе);
    value — значение выбранного пункта, placeholder — подпись без выбора, onChange — действие при выборе другого.
    A drop-down list: the <MenuItem value text> items or items + <ItemTemplate> with a MenuItem (only together);
    value is the selected item value, placeholder is the label without a choice, onChange is the action on choosing another.
  -->
  <xs:complexType name="ComboBoxType" mixed="true">
    <xs:complexContent>
      <xs:extension base="ElementBase">
        <xs:sequence>
          <xs:element name="MenuItem" type="MenuItemType" minOccurs="0" maxOccurs="unbounded"/>
          <xs:element name="ItemTemplate" type="ComboItemTemplateType" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="value" type="xs:string"/>
        <xs:attribute name="placeholder" type="xs:string"/>
        <xs:attribute name="onChange" type="Action"/>
        <xs:attribute name="items" type="ModelName"/>
        <xs:assert test="exists(@items) = exists(ItemTemplate)"/>
        <xs:assert test="not(MenuItem/Popup)"/>
        <xs:assert test="not(text()[normalize-space(.)])"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <!-- Шаблон пункта ComboBox: ровно один MenuItem / A ComboBox item template: exactly one MenuItem -->
  <xs:complexType name="ComboItemTemplateType">
    <xs:sequence>
      <xs:element name="MenuItem" type="MenuItemType"/>
    </xs:sequence>
  </xs:complexType>

  <!--
    Встроенный браузер системы: страница по адресу source или HTML в теге (удобно в CDATA), не оба сразу.
    Размер — только из стиля (у страницы нет собственного размера). onMessage — действие на строку из страницы.
    The system embedded browser: a page at the source address or HTML in the tag (handy in CDATA), not both.
    The size comes only from the style (a page has no intrinsic size). onMessage is the action for a string from the page.
  -->
  <xs:complexType name="WebViewType" mixed="true">
    <xs:complexContent>
      <xs:extension base="ElementBase">
        <xs:attribute name="source" type="xs:string"/>
        <xs:attribute name="onMessage" type="Action"/>
        <xs:assert test="not(@source and text()[normalize-space(.)])"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="CheckBoxType" mixed="true">
    <xs:complexContent>
      <xs:extension base="ElementBase">
        <xs:attribute name="checked" type="BindableBoolean"/>
        <xs:attribute name="text" type="xs:string"/>
        <xs:attribute name="onChange" type="Action"/>
        <xs:assert test="not(text()[normalize-space(.)])"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <!--
    Радиокнопка: из группы отмечена одна. group — имя группы на всё окно (как name у <input type="radio">);
    без него группа — соседние радиокнопки без имени. value — значение (без него — подпись text),
    onChange — действие у кнопки, которую отметили.
    A radio button: one of a group is checked. group is the group name for the whole window (as name of <input type="radio">);
    without it the group is the neighbor radio buttons without a name. value is the value (without it — the text label),
    onChange is the action of the button that got checked.
  -->
  <xs:complexType name="RadioButtonType" mixed="true">
    <xs:complexContent>
      <xs:extension base="ElementBase">
        <xs:attribute name="checked" type="BindableBoolean"/>
        <xs:attribute name="text" type="xs:string"/>
        <xs:attribute name="value" type="xs:string"/>
        <xs:attribute name="group" type="xs:NCName"/>
        <xs:attribute name="onChange" type="Action"/>
        <xs:assert test="not(text()[normalize-space(.)])"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <!-- Полоса прогресса: min < max, min ≤ value ≤ max / A progress bar: min < max, min ≤ value ≤ max -->
  <xs:complexType name="ProgressBarType" mixed="true">
    <xs:complexContent>
      <xs:extension base="ElementBase">
        <xs:attribute name="min" type="xs:decimal" default="0"/>
        <xs:attribute name="max" type="xs:decimal" default="100"/>
        <xs:attribute name="value" type="BindableDecimal"/>
        <xs:assert test="(if (@min) then @min else 0) lt (if (@max) then @max else 100)"/>
        <xs:assert test="not(@value) or starts-with(@value, '{') or (@value ge (if (@min) then @min else 0) and @value le (if (@max) then @max else 100))"/>
        <xs:assert test="not(text()[normalize-space(.)])"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <!--
    Вкладки: страницы <Tab text="подпись" value="значение">…</Tab>, над ними — полоса заголовков (её строит
    движок). value у Tabs — значение выбранной страницы (без него и при отсутствии такой — первая), onChange —
    действие при выборе другой. Значение страницы — value, без него — text; значения не повторяются.
    Tabs: the pages <Tab text="label" value="value">…</Tab>, above them — the header strip (the engine builds it).
    value of Tabs is the selected page value (without it and when there is no such page — the first one), onChange is
    the action on choosing another. The page value is value, without it — text; the values do not repeat.
  -->
  <xs:complexType name="TabsType" mixed="true">
    <xs:complexContent>
      <xs:extension base="ElementBase">
        <xs:sequence>
          <xs:element name="Tab" type="TabType" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="value" type="xs:string"/>
        <xs:attribute name="onChange" type="Action"/>
        <xs:attributeGroup ref="StackAttributes"/>
        <xs:assert test="every $t in Tab satisfies count(Tab[(if (@value) then @value else @text)
                         = (if ($t/@value) then $t/@value else $t/@text)]) = 1"/>
        <xs:assert test="not(text()[normalize-space(.)])"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <!-- Страница вкладок: подпись заголовка text и любые элементы / A tab page: the header label text and any elements -->
  <xs:complexType name="TabType" mixed="true">
    <xs:complexContent>
      <xs:extension base="ContainerBase">
        <xs:attribute name="text" type="xs:string" use="required"/>
        <xs:attribute name="value" type="xs:string"/>
        <xs:attributeGroup ref="StackAttributes"/>
        <xs:assert test="not(text()[normalize-space(.)])"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <!--
    Ползунок: min < max, min ≤ value ≤ max, шаг положителен и не больше диапазона. Умолчания min и max
    повторены в утверждениях: значения default не попадают в дерево, которое видят утверждения.
    A slider: min < max, min ≤ value ≤ max, the step is positive and not above the range. The min and max defaults
    are repeated in the assertions: the default values do not get into the tree the assertions see.
  -->
  <xs:complexType name="SliderType" mixed="true">
    <xs:complexContent>
      <xs:extension base="ElementBase">
        <xs:attribute name="min" type="xs:decimal" default="0"/>
        <xs:attribute name="max" type="xs:decimal" default="100"/>
        <xs:attribute name="value" type="BindableDecimal"/>
        <xs:attribute name="step" type="xs:decimal"/>
        <xs:attribute name="onChange" type="Action"/>
        <xs:assert test="(if (@min) then @min else 0) lt (if (@max) then @max else 100)"/>
        <xs:assert test="not(@value) or starts-with(@value, '{') or (@value ge (if (@min) then @min else 0) and @value le (if (@max) then @max else 100))"/>
        <xs:assert test="not(@step) or (@step gt 0 and @step le (if (@max) then @max else 100) - (if (@min) then @min else 0))"/>
        <xs:assert test="not(text()[normalize-space(.)])"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <!-- ================= Ресурсы / Resources ================= -->

  <xs:complexType name="TokenType">
    <xs:attribute name="name" type="xs:NCName" use="required"/>
    <xs:attribute name="value" type="xs:string" use="required"/>
    <!-- Значение темы не ссылается на другое: подстановка в один проход / A theme value does not refer to another -->
    <xs:assert test="not(contains(@value, '$'))"/>
  </xs:complexType>

  <xs:complexType name="ThemeType">
    <xs:sequence>
      <xs:element name="Token" type="TokenType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="FontType">
    <xs:attribute name="family" type="xs:string" use="required"/>
    <xs:attribute name="source" type="xs:string" use="required"/>
    <xs:attribute name="weight" type="FontWeight"/>
    <xs:attribute name="italic" type="xs:boolean"/>
  </xs:complexType>

  <!-- Стиль: именованный набор свойств, может наследовать другой (basedOn) / A style: a named property set, may inherit another -->
  <xs:complexType name="StyleType">
    <xs:group ref="States"/>
    <xs:attribute name="name" type="xs:NCName" use="required"/>
    <xs:attribute name="basedOn" type="xs:NCName"/>
    <xs:attributeGroup ref="StyleAttributes"/>
    <xs:assert test="not(@basedOn = @name)"/>
    <!-- Выражения {…} — только у элементов интерфейса: стиль и кадр общие для многих узлов / {…} expressions are only for UI elements: a style and a frame are shared by many nodes -->
    <xs:assert test="every $a in @* satisfies not(starts-with($a, '{'))"/>
  </xs:complexType>

  <!-- Запись данных: любые атрибуты — поля записи / A data record: any attributes are the record fields -->
  <xs:complexType name="DataItemType">
    <xs:anyAttribute processContents="skip"/>
  </xs:complexType>

  <!-- Тип переменной привязки / The binding variable type -->
  <xs:simpleType name="VariableKind">
    <xs:restriction base="xs:string">
      <xs:enumeration value="string"/>
      <xs:enumeration value="number"/>
      <xs:enumeration value="boolean"/>
    </xs:restriction>
  </xs:simpleType>

  <!--
    Переменная привязки: $name в выражениях {…}; значение меняют код, встроенные команды
    gran:setVariable:имя:значение и gran:toggleVariable:имя, двусторонние привязки полей.
    A binding variable: $name in the {…} expressions; the value is changed by code, the built-in commands
    gran:setVariable:name:value and gran:toggleVariable:name, the two-way bindings of controls.
  -->
  <xs:complexType name="VariableType">
    <xs:attribute name="name" type="xs:NCName" use="required"/>
    <xs:attribute name="type" type="VariableKind" default="string"/>
    <xs:attribute name="value" type="xs:string"/>
    <!-- Значение хранится в настройках программы между запусками / The value is kept in the program settings between runs -->
    <xs:attribute name="persist" type="xs:boolean" default="false"/>
    <!-- Зарезервированные имена: $index — номер записи, $узел.свойство — с точкой / Reserved names: $index is the record number, $node.property has a dot -->
    <xs:assert test="not(@name = 'index' or @name = 'selected' or @name = 'current' or @name = 'depth'
                     or @name = 'expanded' or @name = 'hasChildren')
                     and not(contains(@name, '.'))"/>
    <xs:assert test="not(@type = 'boolean') or not(@value) or @value = 'true' or @value = 'false'"/>
    <xs:assert test="not(@type = 'number') or not(@value) or string(number(@value)) != 'NaN'"/>
  </xs:complexType>

  <!-- Тип столбца таблицы / A table column type -->
  <xs:simpleType name="DataColumnKind">
    <xs:restriction base="xs:string">
      <xs:enumeration value="text"/>
      <xs:enumeration value="number"/>
      <xs:enumeration value="date"/>
      <xs:enumeration value="boolean"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Столбец таблицы: поле записи, заголовок, тип / A table column: the record field, the title, the type -->
  <xs:complexType name="DataColumnType">
    <xs:attribute name="name" type="xs:NCName" use="required"/>
    <xs:attribute name="title" type="xs:string"/>
    <xs:attribute name="type" type="DataColumnKind" default="text"/>
  </xs:complexType>

  <!--
    Поле записи из файла: XML — XPath 1.0 относительно элемента записи (@price, title), JSON — имена через точку.
    A record field from a file: XML — XPath 1.0 relative to the record element (@price, title), JSON — dot separated names.
  -->
  <xs:complexType name="DataFieldType">
    <xs:attribute name="name" type="xs:NCName" use="required"/>
    <xs:attribute name="path" type="xs:string" use="required"/>
  </xs:complexType>

  <!-- Формат файла источника (без него — по расширению) / The source file format (without it — by the extension) -->
  <xs:simpleType name="DataFormat">
    <xs:restriction base="xs:string">
      <xs:enumeration value="json"/>
      <xs:enumeration value="xml"/>
    </xs:restriction>
  </xs:simpleType>

  <!--
    Файл источника: путь от файла разметки, select — путь к записям (XML: шаги / и // с именами и *;
    JSON: имена через точку), format — формат файла.
    The source file: a path from the markup file, select is the path to the records (XML: / and // steps with names and *;
    JSON: dot separated names), format is the file format.
  -->
  <xs:attributeGroup name="DataSourceAttributes">
    <xs:attribute name="source" type="xs:string"/>
    <xs:attribute name="select" type="xs:string"/>
    <xs:attribute name="format" type="DataFormat"/>
  </xs:attributeGroup>

  <!-- Ключи сортировки: «поле[:text|number|natural] [asc|desc]» через запятую / Sort keys: comma separated "field[:text|number|natural] [asc|desc]" -->
  <xs:simpleType name="SortKeys">
    <xs:restriction base="xs:string">
      <xs:pattern value="\s*[^,:\s]+(:(text|number|natural))?(\s+(asc|desc))?\s*(,\s*[^,:\s]+(:(text|number|natural))?(\s+(asc|desc))?\s*)*"/>
    </xs:restriction>
  </xs:simpleType>

  <!--
    Модель списка name (таблица — со столбцами Column): записи Item или файл source с полями Field;
    fetch — размер порции ленивой подгрузки (0 или нет — всё сразу).
    The list model name (a table — with Column columns): Item records or a source file with Field fields;
    fetch is the lazy loading portion size (0 or absent — everything at once).
  -->
  <xs:complexType name="DataType">
    <xs:sequence>
      <xs:element name="Column" type="DataColumnType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="Field" type="DataFieldType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="Item" type="DataItemType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="name" type="xs:NCName" use="required"/>
    <xs:attributeGroup ref="DataSourceAttributes"/>
    <xs:attribute name="fetch" type="xs:nonNegativeInteger"/>
    <xs:assert test="not(@source and Item)"/>
    <xs:assert test="@source or not(Field or @select or @fetch or @format)"/>
  </xs:complexType>

  <!-- Узел дерева: поля — атрибуты, дети — вложенные Item / A tree node: the fields are the attributes, the children are nested Items -->
  <xs:complexType name="TreeItemType">
    <xs:sequence>
      <xs:element name="Item" type="TreeItemType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:anyAttribute processContents="skip"/>
  </xs:complexType>

  <!--
    Модель дерева name: вложенные Item или файл source; children — имя элемента (XML) или члена (JSON) с детьми узла.
    The tree model name: nested Items or a source file; children is the element (XML) or member (JSON) name with the node children.
  -->
  <xs:complexType name="TreeType">
    <xs:sequence>
      <xs:element name="Field" type="DataFieldType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="Item" type="TreeItemType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="name" type="xs:NCName" use="required"/>
    <xs:attributeGroup ref="DataSourceAttributes"/>
    <xs:attribute name="children" type="xs:string"/>
    <xs:assert test="not(@source and Item)"/>
    <xs:assert test="@source or not(Field or @select or @format or @children)"/>
  </xs:complexType>

  <!--
    Плоское представление дерева tree для списков: раскрытые узлы подряд ($depth, $expanded, $hasChildren);
    expanded — сколько уровней раскрыть сразу, sort — порядок братьев, filter — XPath (предки подходящих видны).
    A flat view of the tree for lists: the expanded nodes in a row ($depth, $expanded, $hasChildren);
    expanded is how many levels to expand at once, sort is the sibling order, filter is XPath (the ancestors of matches are visible).
  -->
  <xs:complexType name="TreeListType">
    <xs:attribute name="name" type="xs:NCName" use="required"/>
    <xs:attribute name="tree" type="xs:NCName" use="required"/>
    <xs:attribute name="expanded" type="xs:nonNegativeInteger" default="0"/>
    <xs:attribute name="sort" type="SortKeys"/>
    <xs:attribute name="filter" type="xs:string"/>
  </xs:complexType>

  <!--
    Прокси сортировки и фильтра над списком source (объявленным раньше или созданным кодом);
    filter — XPath 1.0 по записи (@поле) с переменными $имя, пересчитывается при их смене.
    A sort and filter proxy over the source list (declared earlier or created by code);
    filter is XPath 1.0 over the record (@field) with $name variables, recomputed when they change.
  -->
  <xs:complexType name="SortFilterType">
    <xs:attribute name="name" type="xs:NCName" use="required"/>
    <xs:attribute name="source" type="xs:NCName" use="required"/>
    <xs:attribute name="sort" type="SortKeys"/>
    <xs:attribute name="filter" type="xs:string"/>
  </xs:complexType>

  <!-- Режим выделения / The selection mode -->
  <xs:simpleType name="SelectionKind">
    <xs:restriction base="xs:string">
      <xs:enumeration value="none"/>
      <xs:enumeration value="single"/>
      <xs:enumeration value="multi"/>
      <xs:enumeration value="extended"/>
    </xs:restriction>
  </xs:simpleType>

  <!--
    Модель выделения списка model: в выражениях $имя.current, $имя.count и имя/Item — копии отмеченных записей.
    The selection model of the model list: in expressions $name.current, $name.count and name/Item — copies of the marked records.
  -->
  <xs:complexType name="SelectionType">
    <xs:attribute name="name" type="xs:NCName" use="required"/>
    <xs:attribute name="model" type="xs:NCName" use="required"/>
    <xs:attribute name="mode" type="SelectionKind" default="extended"/>
  </xs:complexType>

  <!--
    Команда (как QAction): кнопки и пункты меню ссылаются на неё атрибутом command, сочетания key работают
    в области scope (window — окно, focus — фокус внутри элемента within, global — все окна приложения).
    action — действие (без него — действие с именем id), text — подпись элементов без своей, enabled="false" —
    команда и её элементы выключены (код меняет это setCommandEnabled).
    A command (as QAction): buttons and menu items refer to it by the command attribute, the key shortcuts work
    in the scope area (window — the window, focus — the focus inside the within element, global — all the application windows).
    action is the action (without it — the action named id), text is the label of the controls without their own, enabled="false" —
    the command and its controls are disabled (the code changes it with setCommandEnabled).
  -->
  <xs:complexType name="CommandType">
    <xs:attribute name="id" type="xs:NCName" use="required"/>
    <xs:attribute name="text" type="xs:string"/>
    <xs:attribute name="action" type="PlainAction"/>
    <xs:attribute name="key" type="ShortcutList"/>
    <xs:attribute name="scope" type="CommandScope" default="window"/>
    <xs:attribute name="within" type="xs:NCName"/>
    <xs:attribute name="enabled" type="xs:boolean"/>
    <!-- within нужен ровно области focus / within is needed exactly by the focus scope -->
    <xs:assert test="(@scope = 'focus') = exists(@within)"/>
  </xs:complexType>

  <!--
    Ключевой кадр: место и только анимируемые свойства (те же, что у переходов); easing — кривая
    участка до следующего кадра. A keyframe: the place and only the animatable properties (the same
    as for transitions); easing is the curve of the segment up to the next frame.
  -->
  <xs:complexType name="FrameType">
    <xs:attribute name="at" type="KeyframeOffset" use="required"/>
    <xs:attribute name="easing" type="xs:string"/>
    <xs:attribute name="background" type="Paint"/>
    <xs:attribute name="borderColor" type="Color"/>
    <xs:attribute name="color" type="Color"/>
    <xs:attribute name="opacity" type="Opacity"/>
    <xs:attribute name="transform" type="Transform"/>
    <xs:attribute name="boxShadow" type="Shadows"/>
    <xs:attribute name="borderRadius" type="Radii"/>
    <xs:attribute name="accentColor" type="Color"/>
    <!-- Выражения {…} — только у элементов интерфейса: стиль и кадр общие для многих узлов / {…} expressions are only for UI elements: a style and a frame are shared by many nodes -->
    <xs:assert test="every $a in @* satisfies not(starts-with($a, '{'))"/>
  </xs:complexType>

  <!-- Набор ключевых кадров для свойства animation / A keyframe set for the animation property -->
  <xs:complexType name="KeyframesType">
    <xs:sequence>
      <xs:element name="Frame" type="FrameType" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="name" type="xs:NCName" use="required"/>
  </xs:complexType>

  <xs:complexType name="ResourcesType">
    <xs:sequence>
      <xs:element name="Theme" type="ThemeType" minOccurs="0"/>
      <xs:element name="Font" type="FontType" minOccurs="0" maxOccurs="unbounded"/>
      <!-- Кадры — до стилей: имена в animation проверяются при чтении стиля / Keyframes go before styles: the animation names are checked when a style is read -->
      <xs:element name="Keyframes" type="KeyframesType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="Style" type="StyleType" minOccurs="0" maxOccurs="unbounded"/>
      <!-- Модели и представления в порядке объявления: основа — раньше представления / Models and views in the declaration order: the base goes before the view -->
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="Data" type="DataType"/>
        <xs:element name="Tree" type="TreeType"/>
        <xs:element name="TreeList" type="TreeListType"/>
        <xs:element name="SortFilter" type="SortFilterType"/>
        <xs:element name="Selection" type="SelectionType"/>
      </xs:choice>
      <xs:element name="Variable" type="VariableType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="Command" type="CommandType" minOccurs="0" maxOccurs="unbounded"/>
      <!-- Библиотеки компонентов: <xi:include href="файл.xml"/>, корень файла — <Library> / Component libraries: <xi:include href="file.xml"/>, the file root is <Library> -->
      <xs:any namespace="http://www.w3.org/2001/XInclude" processContents="skip" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ================= Компоненты / Components ================= -->

  <!--
    Слот: сюда встают дети экземпляра — со slot="имя" в именованный, остальные в безымянный.
    Свои дети слота — запасное содержимое, если экземпляр в слот ничего не дал.
    A slot: the instance children go here — the ones with slot="name" into the named one, the rest into the unnamed one.
    The slot own children are the fallback content if the instance gave the slot nothing.
  -->
  <xs:complexType name="SlotType">
    <xs:sequence>
      <xs:group ref="UiElement" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="name" type="xs:NCName"/>
  </xs:complexType>

  <!-- Тип параметра компонента (тип атрибута экземпляра в сгенерированной схеме) / A component parameter type (the instance attribute type in the generated schema) -->
  <xs:simpleType name="ParamKind">
    <xs:restriction base="xs:string">
      <xs:enumeration value="string"/>
      <xs:enumeration value="number"/>
      <xs:enumeration value="boolean"/>
      <xs:enumeration value="color"/>
      <xs:enumeration value="paint"/>
      <xs:enumeration value="length"/>
      <xs:enumeration value="size"/>
      <xs:enumeration value="action"/>
      <!-- Имя модели для items, selection, source (имя или {$параметр}) / A model name for items, selection, source (a name or {$parameter}) -->
      <xs:enumeration value="model"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Имя модели или выражение, передающее параметр дальше / A model name or an expression passing a parameter further -->
  <xs:simpleType name="ModelName">
    <xs:union memberTypes="xs:NCName Binding"/>
  </xs:simpleType>

  <!-- Допустимые значения строкового параметра / The allowed values of a string parameter -->
  <xs:simpleType name="ParamValues">
    <xs:list itemType="xs:NMTOKEN"/>
  </xs:simpleType>

  <!--
    Параметр: атрибут экземпляра, в теле — {$имя}. required — экземпляр обязан его задать; default — значение,
    если не задал; values — перечисление (только у string).
    A parameter: an instance attribute, {$name} in the body. required — the instance must set it; default — the value
    if it did not; values — an enumeration (string only).
  -->
  <xs:complexType name="ParamType">
    <xs:attribute name="name" type="xs:NCName" use="required"/>
    <xs:attribute name="type" type="ParamKind" default="string"/>
    <xs:attribute name="required" type="xs:boolean"/>
    <xs:attribute name="default" type="xs:string"/>
    <xs:attribute name="values" type="ParamValues"/>
    <xs:assert test="not((@required = 'true' or @required = '1') and exists(@default))"/>
    <xs:assert test="not(@values) or not(@type) or @type = 'string'"/>
    <xs:assert test="not(@type = 'boolean') or not(@default) or @default = 'true' or @default = 'false'"/>
  </xs:complexType>

  <!--
    Компонент: параметры, стили (видны только внутри него) и тело — ровно один элемент интерфейса.
    id в теле локальны: настоящий id узла — «id экземпляра.id».
    A component: the parameters, the styles (visible only inside it) and the body — exactly one UI element.
    The ids in the body are local: the real node id is "instance id.id".
  -->
  <xs:complexType name="ComponentType">
    <xs:sequence>
      <xs:element name="Param" type="ParamType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="Style" type="StyleType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:group ref="UiElement"/>
    </xs:sequence>
    <xs:attribute name="name" type="xs:NCName" use="required"/>
  </xs:complexType>

  <!--
    Библиотека компонентов — отдельный файл; окно подключает её <xi:include> в Resources, экземпляры пишутся
    в пространстве имён namespace. Стили библиотеки видны всем её компонентам.
    A component library is a separate file; a window includes it with <xi:include> in Resources, the instances are written
    in the namespace. The library styles are visible to all its components.
  -->
  <xs:complexType name="LibraryType">
    <xs:sequence>
      <xs:element name="Style" type="StyleType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="Component" type="ComponentType" minOccurs="0" maxOccurs="unbounded">
        <xs:unique name="uniqueParam">
          <xs:selector xpath="Param"/>
          <xs:field xpath="@name"/>
        </xs:unique>
        <xs:unique name="uniqueComponentStyle">
          <xs:selector xpath="Style"/>
          <xs:field xpath="@name"/>
        </xs:unique>
        <xs:unique name="uniqueSlot">
          <xs:selector xpath=".//Slot"/>
          <xs:field xpath="@name"/>
        </xs:unique>
        <!-- id уникальны в теле компонента / ids are unique in a component body -->
        <xs:unique name="uniqueLocalId">
          <xs:selector xpath=".//*"/>
          <xs:field xpath="@id"/>
        </xs:unique>
        <xs:keyref name="localLabelRef" refer="uniqueLocalId">
          <xs:selector xpath=".//*"/>
          <xs:field xpath="@labeledBy"/>
        </xs:keyref>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="namespace" type="xs:anyURI" use="required"/>
  </xs:complexType>

  <xs:element name="Library" type="LibraryType">
    <xs:unique name="uniqueComponent">
      <xs:selector xpath="Component"/>
      <xs:field xpath="@name"/>
    </xs:unique>
    <xs:unique name="uniqueLibraryStyle">
      <xs:selector xpath="Style"/>
      <xs:field xpath="@name"/>
    </xs:unique>
  </xs:element>

  <!-- ================= Окно / Window ================= -->

  <xs:complexType name="WindowType">
    <xs:sequence>
      <xs:element name="Resources" type="ResourcesType" minOccurs="0"/>
      <xs:group ref="UiElement"/>
    </xs:sequence>
    <xs:attribute name="title" type="xs:string"/>
    <xs:attribute name="width" type="NonNegativeNumber" default="800"/>
    <xs:attribute name="height" type="NonNegativeNumber" default="600"/>
    <xs:attribute name="minWidth" type="NonNegativeNumber"/>
    <xs:attribute name="minHeight" type="NonNegativeNumber"/>
    <xs:attribute name="resizable" type="xs:boolean"/>
    <!-- Действие при попытке закрыть окно (крестик, Alt+F4); задано — окно закрывает обработчик (closeWindow) -->
    <!-- The action on an attempt to close the window (the cross, Alt+F4); when set, the handler closes the window (closeWindow) -->
    <xs:attribute name="onClose" type="PlainAction"/>
    <xs:attribute name="titleBar" type="TitleBar" default="system"/>
    <xs:attribute name="kind" type="WindowKind" default="normal"/>
    <xs:attribute name="position" type="WindowPosition" default="default"/>
    <!-- Имя раскладки в настройках программы: место, размер и атрибуты persist окна сохраняются между запусками -->
    <!-- The layout name in the program settings: the window place, size and persist attributes are kept between runs -->
    <xs:attribute name="layout" type="xs:NCName"/>
    <xs:attribute name="background" type="Paint"/>
    <xs:attributeGroup ref="TextAttributes"/>
    <!-- Окно — не узел интерфейса: выражений у его атрибутов нет / The window is not a UI node: its attributes have no expressions -->
    <xs:assert test="not(starts-with(@background, '{') or starts-with(@color, '{') or starts-with(@fontSize, '{'))"/>
    <xs:assert test="not(@minWidth) or @minWidth le @width"/>
    <xs:assert test="not(@minHeight) or @minHeight le @height"/>
  </xs:complexType>

  <xs:element name="Window" type="WindowType">
    <!-- id уникальны в окне / ids are unique in a window -->
    <xs:unique name="uniqueId">
      <xs:selector xpath=".//*"/>
      <xs:field xpath="@id"/>
    </xs:unique>
    <!-- labeledBy ссылается только на существующий id / labeledBy refers only to an existing id -->
    <xs:keyref name="labelRef" refer="uniqueId">
      <xs:selector xpath=".//*"/>
      <xs:field xpath="@labeledBy"/>
    </xs:keyref>
    <!-- within команды ссылается только на существующий id / A command within refers only to an existing id -->
    <xs:keyref name="withinRef" refer="uniqueId">
      <xs:selector xpath="Resources/Command"/>
      <xs:field xpath="@within"/>
    </xs:keyref>
    <!-- Имена значений темы уникальны / Theme value names are unique -->
    <xs:unique name="uniqueToken">
      <xs:selector xpath="Resources/Theme/Token"/>
      <xs:field xpath="@name"/>
    </xs:unique>
    <!-- Имена наборов ключевых кадров уникальны / Keyframe set names are unique -->
    <xs:unique name="uniqueKeyframes">
      <xs:selector xpath="Resources/Keyframes"/>
      <xs:field xpath="@name"/>
    </xs:unique>
    <!-- Имена моделей всех видов уникальны / The model names of all kinds are unique -->
    <xs:unique name="uniqueData">
      <xs:selector xpath="Resources/Data | Resources/Tree | Resources/TreeList | Resources/SortFilter | Resources/Selection"/>
      <xs:field xpath="@name"/>
    </xs:unique>
    <!-- Имена переменных уникальны / Variable names are unique -->
    <xs:unique name="uniqueVariable">
      <xs:selector xpath="Resources/Variable"/>
      <xs:field xpath="@name"/>
    </xs:unique>
    <!-- Стили объявлены один раз; style и basedOn ссылаются только на объявленные -->
    <!-- Styles are declared once; style and basedOn refer only to declared ones -->
    <xs:key name="styleKey">
      <xs:selector xpath="Resources/Style"/>
      <xs:field xpath="@name"/>
    </xs:key>
    <xs:keyref name="styleRef" refer="styleKey">
      <xs:selector xpath=".//*"/>
      <xs:field xpath="@style"/>
    </xs:keyref>
    <xs:keyref name="basedOnRef" refer="styleKey">
      <xs:selector xpath="Resources/Style"/>
      <xs:field xpath="@basedOn"/>
    </xs:keyref>
  </xs:element>
</xs:schema>
