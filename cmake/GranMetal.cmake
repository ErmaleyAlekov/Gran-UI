# ============================================================================
#  Metal на macOS (шаг M5): библиотека шейдеров и Objective-C++ бэкенда, как в Makefile.
#  Тексты MSL (src/rhi/shaders_gen/msl/*.metal, сгенерированы make shaders-metal) → AIR → gran.metallib
#  → массив gran::generated::METAL_LIBRARY (gran_embed). Нужен компилятор Metal из Xcode (xcrun metal).
#  Файлы .mm собираются компилятором C++ в режиме Objective-C++ с ARC (ARC владеет объектами Metal).
#  Включается из CMakeLists.txt до add_library(gran): задаёт GRAN_METAL_SOURCES и дополняет
#  GRAN_GENERATED_SOURCES и GRAN_SYSTEM_LIBS.
# ============================================================================
#  Metal on macOS (step M5): the shader library and the backend Objective-C++, as in the Makefile.
#  The MSL texts (src/rhi/shaders_gen/msl/*.metal, generated by make shaders-metal) → AIR → gran.metallib
#  → the gran::generated::METAL_LIBRARY array (gran_embed). The Metal compiler from Xcode is needed (xcrun metal).
#  The .mm files are built by the C++ compiler in Objective-C++ mode with ARC (ARC owns the Metal objects).
#  Included from CMakeLists.txt before add_library(gran): sets GRAN_METAL_SOURCES and extends
#  GRAN_GENERATED_SOURCES and GRAN_SYSTEM_LIBS.
# ============================================================================
set(GRAN_METAL_SOURCES "")
if(NOT (APPLE AND GRAN_NATIVE))
    return()
endif()

set(GRAN_METAL_DIR "${CMAKE_CURRENT_SOURCE_DIR}/src/rhi/shaders_gen/msl")
set(GRAN_METAL_TMP "${CMAKE_BINARY_DIR}/shaders/msl")
file(GLOB GRAN_METAL_SHADERS CONFIGURE_DEPENDS "${GRAN_METAL_DIR}/*.metal")

# Каждый шейдер → AIR с предупреждениями как ошибками; -fno-fast-math — точная математика, ближе к эталонам D3D (см. Makefile)
# Each shader → AIR with warnings as errors; -fno-fast-math — precise math, closer to the D3D baselines (see the Makefile)
set(GRAN_METAL_AIR "")
foreach(shader IN LISTS GRAN_METAL_SHADERS)
    get_filename_component(name "${shader}" NAME_WE)
    set(air "${GRAN_METAL_TMP}/${name}.air")
    add_custom_command(
        OUTPUT "${air}"
        COMMAND "${CMAKE_COMMAND}" -E make_directory "${GRAN_METAL_TMP}"
        COMMAND xcrun -sdk macosx metal -std=macos-metal2.3 -mmacosx-version-min=${CMAKE_OSX_DEPLOYMENT_TARGET}
            -fno-fast-math -Werror -c "${shader}" -o "${air}"
        DEPENDS "${shader}"
        COMMENT "xcrun metal ${name}"
        VERBATIM)
    list(APPEND GRAN_METAL_AIR "${air}")
endforeach()

# Все AIR → одна библиотека; точки входа шейдеров не пересекаются / All AIR → one library; the shader entry points do not overlap
add_custom_command(
    OUTPUT "${GRAN_METAL_TMP}/gran.metallib"
    COMMAND xcrun -sdk macosx metallib ${GRAN_METAL_AIR} -o "${GRAN_METAL_TMP}/gran.metallib"
    DEPENDS ${GRAN_METAL_AIR}
    COMMENT "xcrun metallib gran.metallib"
    VERBATIM)
gran_embed_file("${GRAN_METAL_TMP}/gran.metallib" rhi/metal_library.cpp METAL_LIBRARY)

# Objective-C++ с ARC: тот же компилятор и флаги C++, плюс режим языка / Objective-C++ with ARC: the same C++ compiler and flags, plus the language mode
file(GLOB GRAN_METAL_SOURCES CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/src/rhi/metal/*.mm")
set_source_files_properties(${GRAN_METAL_SOURCES} PROPERTIES LANGUAGE CXX
    COMPILE_OPTIONS "-x;objective-c++;-fobjc-arc")
list(APPEND GRAN_SYSTEM_LIBS "-framework Metal" "-framework Foundation")
