<?xml version="1.0" encoding="UTF-8"?>
<!--
  Виджеты выбора и состояния: вкладки, радиокнопки, переключатели, полосы прогресса.
  Стрелки ходят внутри группы радиокнопок и по вкладкам, Tab — к следующему элементу за группой.
  Запуск: gran_gallery samples/widgets.xml

  Choice and state widgets: tabs, radio buttons, switches, progress bars.
  The arrows move inside a radio button group and along the tabs, Tab goes to the next control after the group.
  Run: gran_gallery samples/widgets.xml
-->
<Window title="Gran UI — виджеты" width="640" height="420" background="#f5f6f8">
  <Stack padding="24" spacing="16">
    <Tabs id="tabs" value="general" onChange="choice">
      <Tab text="Общие" value="general" spacing="14">
        <Stack orientation="horizontal" spacing="32">
          <Stack spacing="10">
            <Text fontWeight="600">Тема</Text>
            <RadioButton text="Светлая" value="light" checked="true" onChange="choice"/>
            <RadioButton text="Тёмная" value="dark" onChange="choice"/>
            <RadioButton text="Как в системе" value="system" onChange="choice"/>
          </Stack>
          <Stack spacing="10">
            <Text fontWeight="600">Уведомления</Text>
            <Switch text="Звук" checked="true" onChange="choice"/>
            <Switch text="Всплывающие окна"/>
            <Switch text="Недоступно" enabled="false"/>
          </Stack>
        </Stack>
      </Tab>
      <Tab text="Загрузка" value="download" spacing="12">
        <Text>Файлы</Text>
        <ProgressBar id="progress" value="65" width="320"/>
        <ProgressBar value="20" width="320" accentColor="#16a34a"/>
        <ProgressBar value="100" width="320" height="4"/>
      </Tab>
      <Tab text="О программе">
        <Text color="#667085">Грань UI — виджеты из разметки.</Text>
      </Tab>
    </Tabs>
    <Text fontWeight="600">Размер (группа по имени)</Text>
    <Stack orientation="horizontal" spacing="20">
      <RadioButton group="size" text="S" value="s"/>
      <RadioButton group="size" text="M" value="m" checked="true"/>
      <RadioButton group="size" text="L" value="l"/>
    </Stack>
    <ProgressBar value="40" width="200"/>
    <Text id="status" color="#667085">Готово</Text>
  </Stack>
</Window>
