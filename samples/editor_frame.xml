<?xml version="1.0" encoding="UTF-8"?>
<!--
  Каркас окна большой программы (план 2.1): строка меню и панель инструментов (сузьте окно — кнопки, которым не
  хватает места, уходят в меню «ещё» справа; «Справка» там всегда), строка состояния с ручкой размера окна, разделитель панелей (положение сохраняется между запусками). Строка меню. Alt (нажать и отпустить) или F10 — фокус на строку меню,
  стрелки влево/вправо — соседний пункт, вниз или Enter — открыть меню; Alt+Ф, Alt+П, Alt+В, Alt+С — сразу открыть
  меню «Файл», «Правка», «Вид», «Справка»; в открытом меню буква пункта выбирает его (подчёркнутые буквы видны,
  пока зажат Alt или меню открыто с клавиатуры). Пока меню открыто, наведение на другой пункт строки переключает его.
  Сочетания Ctrl+N, Ctrl+S и др. работают и без меню. Запуск: gran_gallery samples/editor_frame.xml

  A big program window frame (plan 2.1): the menu bar and the toolbar (narrow the window — the buttons without room
  go into the "more" menu on the right; "Справка" is always there), the status bar with the window size grip, the pane splitter (the position is kept between runs). The menu bar. Alt (press and release) or F10 — the focus to the menu bar,
  the left/right arrows — the neighbor item, down or Enter — open the menu; Alt+Ф, Alt+П, Alt+В, Alt+С — open the
  "File", "Edit", "View", "Help" menus at once; in an open menu the item letter chooses it (the underlined letters are shown
  while Alt is held or the menu is open from the keyboard). While a menu is open, hovering another bar item switches it.
  Ctrl+N, Ctrl+S and others work without the menu too. Run: gran_gallery samples/editor_frame.xml
-->
<Window title="Gran UI — каркас окна" width="900" height="560" background="#ffffff" layout="editorFrame">
  <Resources>
    <Command id="newDoc" text="_Новый" key="Mod+N" action="command"/>
    <Command id="openDoc" text="_Открыть…" key="Mod+O" action="command"/>
    <Command id="saveDoc" text="_Сохранить" key="Mod+S" action="command"/>
    <Command id="saveAs" text="Сохранить _как…" key="Mod+Shift+S" action="command"/>
    <Command id="quit" text="_Выход" key="Mod+Q" action="gran:close"/>
    <Command id="undo" text="_Отменить" key="Mod+Z" action="gran:undo" enabled="false"/>
    <Command id="redo" text="_Повторить" key="Mod+Y" action="gran:redo" enabled="false"/>
    <Command id="find" text="_Найти…" key="Mod+F" action="command"/>
  </Resources>
  <Stack grow="1">
    <MenuBar id="menu">
      <MenuItem text="_Файл">
        <Popup>
          <MenuItem command="newDoc"/>
          <MenuItem command="openDoc"/>
          <MenuItem command="saveDoc"/>
          <MenuItem command="saveAs"/>
          <MenuItem command="quit"/>
        </Popup>
      </MenuItem>
      <MenuItem text="_Правка">
        <Popup>
          <MenuItem command="undo"/>
          <MenuItem command="redo"/>
          <MenuItem command="find"/>
        </Popup>
      </MenuItem>
      <MenuItem text="_Вид">
        <Popup>
          <MenuItem text="_Масштаб">
            <Popup>
              <MenuItem text="_Крупнее" onClick="command"/>
              <MenuItem text="_Мельче" onClick="command"/>
              <MenuItem text="_Обычный" onClick="command"/>
            </Popup>
          </MenuItem>
          <MenuItem text="_Строка состояния" onClick="command"/>
        </Popup>
      </MenuItem>
      <MenuItem text="_Справка">
        <Popup>
          <MenuItem text="_О программе" onClick="command"/>
        </Popup>
      </MenuItem>
    </MenuBar>
    <ToolBar id="tools">
      <Button command="newDoc" tooltip="Новый документ"><Icon data="M6 2h8l4 4v16H6zM13 3v4h4" width="16" height="16"/></Button>
      <Button command="openDoc" tooltip="Открыть документ"><Icon data="M3 6h7l2 2h9v12H3z" width="16" height="16"/></Button>
      <Button command="saveDoc" tooltip="Сохранить документ"><Icon data="M5 3h11l3 3v15H5zM8 3v6h8V3M8 21v-7h8v7" width="16" height="16"/></Button>
      <Separator/>
      <ToolGroup>
        <Button command="undo"/>
        <Button command="redo"/>
      </ToolGroup>
      <Separator/>
      <Button command="find"/>
      <Button text="Жирный" onClick="command"/>
      <Button text="Курсив" onClick="command"/>
      <Button text="Подчёркнутый" onClick="command"/>
      <Button text="Справка" onClick="command" overflowMode="always"/>
    </ToolBar>
    <Splitter id="split" grow="1" position="220" minFirst="120" minSecond="240" collapse="first" persist="position collapsed"
              onChange="command">
      <Stack padding="12" spacing="6" background="#fcfcfd">
        <Text fontWeight="600">Структура</Text>
        <Text color="#667085">Перетащите ручку справа; двойной щелчок по ней сворачивает панель.</Text>
      </Stack>
      <TextArea id="editor" margin="12" placeholder="Текст документа: Alt+Ф — меню «Файл», Ctrl+S — сохранить"/>
    </Splitter>
    <StatusBar sizeGrip="true">
      <StatusSection grow="1"><Text id="status">Нажмите Alt или F10, чтобы перейти в меню.</Text></StatusSection>
      <Separator/>
      <StatusSection><Text>Строка 1, столбец 1</Text></StatusSection>
      <Separator/>
      <StatusSection><Text>UTF-8</Text></StatusSection>
    </StatusBar>
  </Stack>
</Window>
