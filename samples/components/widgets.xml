<?xml version="1.0" encoding="UTF-8"?>
<!--
  Библиотека компонентов примера samples/components.xml: карточка со слотами, значок, поле с подписью,
  показатель. Окно подключает её <xi:include href="components/widgets.xml"/> и пишет экземпляры
  в пространстве имён urn:gran:samples:widgets (<w:Card title="…">).

  The component library of the samples/components.xml sample: a card with slots, a badge, a labelled field,
  a metric. A window includes it with <xi:include href="components/widgets.xml"/> and writes the instances
  in the urn:gran:samples:widgets namespace (<w:Card title="…">).
-->
<Library namespace="urn:gran:samples:widgets" xmlns:w="urn:gran:samples:widgets">
  <!-- Стили библиотеки: их видят все её компоненты, окну они не видны / The library styles: all its components see them, the window does not -->
  <Style name="Caption" fontSize="12" color="#667085"/>
  <Style name="Title" fontSize="16" fontWeight="700" color="#101828"/>

  <!-- Значок: цвет и текст — параметры / A badge: the color and the text are parameters -->
  <Component name="Badge">
    <Param name="text" required="true"/>
    <Param name="tone" type="color" default="#3538cd"/>
    <Box padding="2 8" borderRadius="999" background="{$tone}">
      <Text fontSize="11" fontWeight="600" color="#ffffff">{$text}</Text>
    </Box>
  </Component>

  <!--
    Карточка: заголовок, необязательная подпись, слот действий справа от заголовка и безымянный слот
    с запасным содержимым. compact прячет подпись, accent — цвет полосы слева.
    A card: the title, an optional subtitle, the actions slot to the right of the title and the unnamed slot
    with fallback content. compact hides the subtitle, accent is the color of the strip on the left.
  -->
  <Component name="Card">
    <Param name="title" required="true"/>
    <Param name="subtitle"/>
    <Param name="accent" type="color" default="$accent"/>
    <Param name="compact" type="boolean" default="false"/>
    <Param name="badge"/>
    <Style name="Frame" orientation="horizontal" borderRadius="12" background="#ffffff"
           boxShadow="0 1 3 rgba(16,24,40,0.12)" overflow="hidden"/>
    <Stack id="frame" style="Frame">
      <Box width="4" background="{$accent}"/>
      <Stack padding="14 16" spacing="8" grow="1">
        <Stack orientation="horizontal" align="center" spacing="8">
          <Text id="heading" style="Title" grow="1">{$title}</Text>
          <w:Badge text="{$badge}" visible="{string-length($badge) > 0}"/>
          <Slot name="actions"/>
        </Stack>
        <Text style="Caption" visible="{not($compact) and string-length($subtitle) > 0}">{$subtitle}</Text>
        <Slot>
          <Text style="Caption">Пока пусто</Text>
        </Slot>
      </Stack>
    </Stack>
  </Component>

  <!--
    Поле с подписью: value поля двусторонне связано с параметром text (экземпляр text="{$query}" —
    поле пишет в $query); подпись — для дикторов через labeledBy (id локальны у каждого экземпляра).
    A labelled field: the field value is bound two-way to the text parameter (an instance text="{$query}" —
    the field writes into $query); the label is for screen readers through labeledBy (the ids are local to every instance).
  -->
  <Component name="Field">
    <Param name="label" required="true"/>
    <Param name="text"/>
    <Param name="hint"/>
    <Stack spacing="4">
      <Text id="label" style="Caption">{$label}</Text>
      <Input labeledBy="label" placeholder="{$hint}" value="{$text}"/>
    </Stack>
  </Component>

  <!-- Показатель: число крупно и подпись; размер — перечисление / A metric: a big number and a caption; the size is an enumeration -->
  <Component name="Metric">
    <Param name="value" type="number" required="true"/>
    <Param name="caption" required="true"/>
    <Param name="size" values="small large" default="large"/>
    <Stack padding="10 14" spacing="2" borderRadius="10" background="#eef2f6" grow="1">
      <Text fontWeight="700" fontSize="{substring('2014', 1 + 2 * ($size = 'small'), 2)}">{$value}</Text>
      <Text style="Caption">{$caption}</Text>
    </Stack>
  </Component>
</Library>
