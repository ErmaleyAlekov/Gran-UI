<?xml version="1.0" encoding="UTF-8"?>
<!--
  Таблица DataGrid (пункты 2.2.2–2.2.3): заказы из JSON в прокси сортировки и фильтра, столбцы px / auto / fr с пределами,
  своя ячейка состояния (<CellTemplate>), выделение строк, текущая ячейка стрелками влево/вправо, сортировка
  щелчком по заголовку (повторный щелчок — обратный порядок). Строки виртуальные: копии есть только у видимых.
  Край заголовка тянет ширину (двойной щелчок — по содержимому), заголовок переставляет столбец; столбец «№»
  закреплён (frozenColumns), крупные заказы закреплены сверху (pinnedTop). Раскладка столбцов сохраняется в настройках
  окна layout="grid" (у gran_gallery — в настройках программы).
  Пункт 2.2.4: ячейки правятся (editable) — F2, Enter, двойной щелчок или набор символа; Enter записывает, Esc отменяет,
  Tab — соседний столбец; сумма проверяется как число, состояние выбирается списком (<EditTemplate>), «№» не правится.
  Пункт 2.2.5: строка фильтров (filterRow) — подстрока клиента или города, у суммы также «>1000», «<=500».
  Пункт 2.2.6: правку проверяет код программы — событие cellEdit (onCellEdit="checkOrder", обработчик — в gran_gallery):
  клиент не пустой (пробелы по краям срезаются), сумма от 1 до 10 000 000; отказ показывается подсказкой у поля.
  Запуск: gran_snapshot samples/grid.xml grid.png или gran_gallery samples/grid.xml

  A DataGrid table (items 2.2.2–2.2.3): orders from JSON in a sort and filter proxy, px / auto / fr columns with limits,
  an own status cell (<CellTemplate>), row selection, the current cell by the left/right arrows, sorting
  by a header click (a repeated click — the reverse order). The rows are virtual: only the visible ones have copies.
  A header edge drags the width (a double click — by the content), a header reorders the column; the "№" column
  is frozen (frozenColumns), the big orders are pinned at the top (pinnedTop). The column layout is kept in the settings
  of the window layout="grid" (for gran_gallery — in the program settings).
  Item 2.2.4: the cells are editable (editable) — F2, Enter, a double click or typing a character; Enter writes, Esc cancels,
  Tab — the neighbor column; the sum is checked as a number, the status is chosen from a list (<EditTemplate>), "№" is not editable.
  Item 2.2.5: the filter row (filterRow) — a substring of the client or the city, for the sum also ">1000", "<=500".
  Item 2.2.6: the program code checks an edit — the cellEdit event (onCellEdit="checkOrder", the handler is in gran_gallery):
  the client is not empty (the spaces at the edges are cut), the sum is from 1 to 10,000,000; a refusal is shown as the input tooltip.
  Run: gran_snapshot samples/grid.xml grid.png or gran_gallery samples/grid.xml
-->
<Window title="Gran UI — таблица" width="900" height="520" background="#f5f6f8" layout="grid">
  <Resources>
    <Style name="badge" padding="2 8" borderRadius="10" fontSize="12"/>
    <Data name="orders" source="data/orders.json" select="orders">
      <Column name="number" title="№" type="number"/>
      <Column name="client" title="Клиент"/>
      <Column name="city" title="Город"/>
      <Column name="sum" title="Сумма" type="number"/>
      <Column name="status" title="Состояние"/>
      <Field name="number" path="number"/>
      <Field name="client" path="client.name"/>
      <Field name="city" path="client.city"/>
      <Field name="sum" path="sum"/>
      <Field name="status" path="status"/>
    </Data>
    <SortFilter name="visibleOrders" source="orders" sort="number:number"
                filter="contains(@client, $query) or contains(@city, $query)"/>
    <Selection name="orderSel" model="visibleOrders" mode="extended"/>
    <SortFilter name="bigOrders" source="orders" sort="sum:number desc" filter="@sum > 128000"/>
    <Variable name="query"/>
    <!-- Отмена правок ячеек вне редактора (в поле Ctrl+Z отменяет набор в поле) / Undoing cell edits outside the editor (in an input Ctrl+Z undoes the typing) -->
    <Command id="undo" key="Mod+Z" action="gran:undo"/>
    <Command id="redo" key="Mod+Y Mod+Shift+Z" action="gran:redo"/>
  </Resources>
  <Stack padding="16" spacing="12">
    <Stack orientation="horizontal" spacing="12" align="center">
      <Text fontSize="18" fontWeight="700" grow="1">Заказы</Text>
      <Input width="220" placeholder="Клиент или город" value="{$query}"/>
    </Stack>
    <DataGrid id="orders" accessibleName="Заказы" items="visibleOrders" selection="orderSel" grow="1" frozenColumns="1" pinnedTop="bigOrders"
              editable="true" filterRow="true" onCellEdit="checkOrder">
      <GridColumn field="number" title="№" width="64" textAlign="end" color="#667085" editable="false" filterable="false"/>
      <GridColumn field="client" title="Клиент" width="1fr" minWidth="160"/>
      <GridColumn field="city" title="Город" width="auto" maxWidth="180"/>
      <GridColumn field="sum" title="Сумма" width="110" textAlign="end"/>
      <GridColumn field="status" title="Состояние" width="130">
        <CellTemplate>
          <Text style="badge" background="{substring('#ecfdf3#fef3f2', 1 + 7 * (@status != 'оплачен'), 7)}"
                color="{substring('#067647#b42318', 1 + 7 * (@status != 'оплачен'), 7)}">{status}</Text>
        </CellTemplate>
        <EditTemplate>
          <ComboBox>
            <MenuItem value="ожидает" text="ожидает"/>
            <MenuItem value="оплачен" text="оплачен"/>
            <MenuItem value="отгружен" text="отгружен"/>
            <MenuItem value="отменён" text="отменён"/>
          </ComboBox>
        </EditTemplate>
      </GridColumn>
    </DataGrid>
    <Stack orientation="horizontal" spacing="16">
      <Text color="#667085" fontSize="13" grow="1">Показано {count(visibleOrders/Item)} из {count(orders/Item)}, выбрано {$orderSel.count} на сумму {sum(orderSel/Item/@sum)}</Text>
      <Text id="editStatus" color="#667085" fontSize="13"/>
    </Stack>
  </Stack>
</Window>
